(\uc0\u1633 \u1633 \u1638 ) \u1608 \u1610 \u1606 \u1576 \u1594 \u1610  \u1571 \u1606  \u1606 \u1593 \u1604 \u1605  \u1571 \u1606  \u1605 \u1580 \u1605 \u1608 \u1593 \u1575 \u1578  \u1575 \u1604 \u1605 \u1602 \u1583 \u1605 \u1575 \u1578  \u1607 \u1610  \u1576 \u1571 \u1593 \u1610 \u1575 \u1606 \u1607 \u1575  \u1601 \u1610  \u1575 \u1604 \u1580 \u1606 \u1587  \u1605 \u1580 \u1605 \u1608 \u1593 \u1575 \u1578  \u1575 \u1604 \u1605 \u1591 \u1604 \u1608 \u1576 \u1575 \u1578 . \u1601 \u1573 \u1606  \u1603 \u1604  \u1605 \u1602 \u1583 \u1605 \u1577  \u1580 \u1583 \u1604 \u1610 \u1577  \u1601 \u1604 \u1610 \u1587  \u1610 \u1582 \u1604 \u1608  \u1605 \u1580 \u1605 \u1608 \u1593 \u1607 \u1575  \u1605 \u1606  \u1571 \u1606  \u1610 \u1603 \u1608 \u1606  \u1580 \u1606 \u1587 \u1575 \u1611  \u1571 \u1608  \u1601 \u1589 \u1604 \u1575 \u1611  \u1571 \u1608  \u1582 \u1575 \u1589 \u1577 \u1611  \u1571 \u1608  \u1581 \u1583 \u1617 \u1575 \u1611  \u1571 \u1608  \u1585 \u1587 \u1575 \u1611  \u1571 \u1608  \u1593 \u1585 \u1590 \u1575 \u1611  \u1571 \u1608  \u1588 \u1610 \u1574 \u1575 \u1611  \u1594 \u1610 \u1585  \u1584 \u1604 \u1603  \u1605 \u1605 \u1575  \u1610 \u1581 \u1578 \u1605 \u1604  \u1605 \u1580 \u1605 \u1608 \u1593 \u1575 \u1611  \u1601 \u1610  \u1575 \u1604 \u1605 \u1591 \u1604 \u1608 \u1576 . \u1608 \u1603 \u1584 \u1604 \u1603  \u1602 \u1583  \u1610 \u1603 \u1608 \u1606  \u1601 \u1610  \u1575 \u1604 \u1605 \u1602 \u1583 \u1605 \u1575 \u1578  \u1605 \u1575  \u1605 \u1580 \u1605 \u1608 \u1593 \u1607  \u1605 \u1580 \u1605 \u1608 \u1593  \u1576 \u1575 \u1604 \u1571 \u1603 \u1579 \u1585  \u1571 \u1608  \u1575 \u1604 \u1571 \u1602 \u1604 . \u1601 \u1578 \u1603 \u1608 \u1606  \u1571 \u1580 \u1606 \u1575 \u1587  \u1575 \u1604 \u1605 \u1602 \u1583 \u1605 \u1575 \u1578  \u1575 \u1604 \u1580 \u1583 \u1604 \u1610 \u1577  \u1605 \u1606  \u1580 \u1607 \u1577  \u1605 \u1580 \u1605 \u1608 \u1593 \u1575 \u1578 \u1607 \u1575  \u1593 \u1604 \u1609  \u1593 \u1583 \u1583  \u1571 \u1580 \u1606 \u1575 \u1587  \u1575 \u1604 \u1605 \u1591 \u1604 \u1608 \u1576 \u1575 \u1578 .\
\
(\uc0\u1633 \u1633 \u1639 ) \u1608  \u1605 \u1608 \u1590 \u1608 \u1593 \u1575 \u1578  \u1607 \u1584 \u1607  \u1575 \u1604 \u1589 \u1606 \u1575 \u1593 \u1577  \u1607 \u1610  \u1575 \u1604 \u1571 \u1580 \u1606 \u1575 \u1587  \u1575 \u1604 \u1593 \u1588 \u1585 \u1577  \u1603 \u1604 \u1607 \u1575  \u1608 \u1603 \u1604  \u1605 \u1575  \u1578 \u1581 \u1578 \u1607 \u1575  \u1605 \u1606  \u1575 \u1604 \u1605 \u1593 \u1575 \u1606 \u1610  \u1575 \u1604 \u1603 \u1604 \u1610 \u1577 . \u1608 \u1575 \u1604 \u1571 \u1580 \u1606 \u1575 \u1587  \u1575 \u1604 \u1593 \u1588 \u1585 \u1577  \u1607 \u1610  \u1575 \u1604 \u1580 \u1608 \u1607 \u1585  \u1608 \u1575 \u1604 \u1603 \u1605 \u1610 \u1577  \u1608 \u1575 \u1604 \u1603 \u1610 \u1601 \u1610 \u1577  \u1608 \u1575 \u1604 \u1573 \u1590 \u1575 \u1601 \u1577  (\u1633 ) [\u1576 . \u1634 \u1636 \u1636 ]. \u1608 \u1571 \u1610 \u1606  \u1608 \u1605 \u1578 \u1610  \u1608 \u1575 \u1604 \u1608 \u1590 \u1593  \u1608 \u1571 \u1606  \u1610 \u1603 \u1608 \u1606  \u1604 \u1607  \u1608 \u1571 \u1606  \u1610 \u1601 \u1593 \u1604  \u1608 \u1571 \u1606  \u1610 \u1601 \u1593 \u1604 . \u1608 \u1571 \u1580 \u1606 \u1575 \u1587  \u1575 \u1604 \u1605 \u1602 \u1583 \u1605 \u1575 \u1578  \u1608 \u1575 \u1604 \u1605 \u1591 \u1604 \u1608 \u1576 \u1575 \u1578  \u1578 \u1572 \u1604 \u1601  \u1605 \u1606  \u1607 \u1584 \u1607  \u1603 \u1604 \u1607 \u1575 . \u1601 \u1573 \u1606  \u1605 \u1608 \u1590 \u1608 \u1593  \u1603 \u1604  \u1605 \u1602 \u1583 \u1605 \u1577  \u1608 \u1603 \u1604  \u1605 \u1591 \u1604 \u1608 \u1576  \u1601 \u1604 \u1610 \u1587  \u1610 \u1582 \u1604 \u1608  \u1605 \u1606  \u1571 \u1606  \u1610 \u1603 \u1608 \u1606  \u1573 \u1605 \u1575  \u1580 \u1608 \u1607 \u1585 \u1575 \u1611  \u1608 \u1573 \u1605 \u1575  \u1603 \u1605 \u1610 \u1577  \u1608 \u1573 \u1605 \u1575 \
\
\uc0\u1603 \u1610 \u1601 \u1610 \u1577  \u1608 \u1573 \u1605 \u1575  \u1583 \u1575 \u1582 \u1604 \u1611 \u1575  \u1578 \u1581 \u1578  \u1588 \u1610 \u1569  \u1605 \u1606  \u1576 \u1575 \u1602 \u1610  \u1575 \u1604 \u1571 \u1580 \u1606 \u1575 \u1587 . \u1608 \u1603 \u1584 \u1604 \u1603  \u1605 \u1593 \u1605 \u1608 \u1604  \u1603 \u1604  \u1605 \u1602 \u1583 \u1605 \u1577  \u1608 \u1603 \u1604  \u1605 \u1591 \u1604 \u1608 \u1576  \u1601 \u1604 \u1610 \u1587  \u1610 \u1582 \u1604 \u1608  \u1573 \u1605 \u1575  (\u1634 ) \u1580 \u1608 \u1607 \u1585 \u1611 \u1575  \u1608 \u1573 \u1605 \u1575  \u1603 \u1605 \u1610 \u1577  \u1571 \u1608  \u1605 \u1608 \u1590 \u1608 \u1593 \u1611 \u1575  \u1576 \u1594 \u1610 \u1585  \u1584 \u1604 \u1603  \u1605 \u1606  \u1576 \u1575 \u1602 \u1610  \u1575 \u1604 \u1605 \u1602 \u1608 \u1604 \u1575 \u1578 . \u1601 \u1573 \u1606  \u1575 \u1604 \u1580 \u1606 \u1587  \u1604 \u1575  \u1610 \u1582 \u1604 \u1608  \u1573 \u1605 \u1575  \u1571 \u1606  \u1610 \u1603 \u1608 \u1606  \u1580 \u1608 \u1607 \u1585 \u1611 \u1575  \u1608 \u1573 \u1605 \u1575  \u1603 \u1605 \u1610 \u1577  \u1608 \u1573 \u1605 \u1575  \u1594 \u1610 \u1585  \u1584 \u1604 \u1603  \u1605 \u1606  \u1576 \u1575 \u1602 \u1610  \u1575 \u1604 \u1605 \u1602 \u1608 \u1604 \u1575 \u1578 \u1548  \u1608 \u1603 \u1584 \u1604 \u1603  \u1575 \u1604 \u1601 \u1589 \u1604  \u1608 \u1603 \u1584 \u1604 \u1603  \u1575 \u1604 \u1582 \u1575 \u1589 \u1577 .\
\
(\uc0\u1633 /\u1633 \u1633 \u1640 ) \u1601 \u1604 \u1610 \u1587  \u1576 \u1610 \u1606  \u1607 \u1604  \u1610 \u1605 \u1603 \u1606  \u1571 \u1606  \u1578 \u1603 \u1608 \u1606  \u1582 \u1575 \u1589 \u1577  \u1588 \u1610 \u1569 \u1548  \u1605 \u1575  \u1583 \u1575 \u1582 \u1604 \u1577  \u1601 \u1610  \u1605 \u1602 \u1608 \u1604 \u1577  \u1575 \u1604 \u1580 \u1608 \u1607 \u1585 . \u1608 \u1575 \u1604 \u1593 \u1585 \u1590  \u1601 \u1571 \u1581 \u1585 \u1609  \u1571 \u1606  \u1604 \u1575  \u1610 \u1603 \u1608 \u1606  \u1601 \u1610  \u1575 \u1604 \u1580 \u1608 \u1607 \u1585 . \u1608 \u1584 \u1604 \u1603  \u1571 \u1606 \u1607  \u1604 \u1575  \u1610 \u1605 \u1603 \u1606  \u1571 \u1606  \u1610 \u1603 \u1608 \u1606  \u1605 \u1593 \u1605 \u1608 \u1604  \u1605 \u1575  \u1583 \u1575 \u1582 \u1604 \u1611 \u1575  \u1578 \u1581 \u1578  \u1605 \u1602 \u1608 \u1604 \u1577  \u1575 \u1604 \u1580 \u1608 \u1607 \u1585  \u1608 \u1607 \u1608  \u1593 \u1585 \u1590  \u1601 \u1610  \u1588 \u1610 \u1569  \u1570 \u1582 \u1585 . \u1608 \u1584 \u1604 \u1603  \u1571 \u1606 \u1607  \u1604 \u1610 \u1587  \u1588 \u1610 \u1569  \u1605 \u1606  \u1575 \u1604 \u1605 \u1593 \u1605 \u1608 \u1604 \u1575 \u1578  \u1583 \u1575 \u1582 \u1604  \u1601 \u1610  \u1575 \u1604 \u1580 \u1608 \u1607 \u1585  \u1583 \u1575 \u1604 \u1611 \u1575  \u1593 \u1604 \u1609  \u1588 \u1610 \u1569  \u1582 \u1575 \u1585 \u1580  \u1605 \u1606  \u1584 \u1575 \u1578  \u1605 \u1608 \u1590 \u1608 \u1593 \u1607 \u1548  \u1576 \u1604  \u1580 \u1605 \u1610 \u1593 \u1607 \u1575  \u1610 \u1583 \u1604  \u1593 \u1604 \u1609  \u1584 \u1575 \u1578  \u1605 \u1608 \u1590 \u1608 \u1593 \u1607  \u1608 \u1593 \u1604 \u1609  \u1605 \u1575  \u1607 \u1608  \u1584 \u1604 \u1603  \u1575 \u1604 \u1588 \u1610 \u1569 . \u1601 \u1584 \u1604 \u1603  \u1573 \u1605 \u1575  \u1610 \u1603 \u1608 \u1606  \u1580 \u1606 \u1587 \u1611 \u1575  \u1604 \u1605 \u1608 \u1590 \u1608 \u1593 \u1607  \u1571 \u1608  \u1601 \u1589 \u1604 \u1575 \u1611  \u1604 \u1607  \u1571 \u1608  \u1581 \u1584 \u1575 \u1611  \u1571 \u1608  \u1606 \u1608 \u1593 \u1611 \u1575  \u1573 \u1606  \u1603 \u1575 \u1606  \u1605 \u1608 \u1590 \u1608 \u1593 \u1607  \u1588 \u1582 \u1589 \u1611 \u1575  - \u1594 \u1610 \u1585  \u1571 \u1606  \u1575 \u1604 \u1602 \u1590 \u1610 \u1577  \u1575 \u1604 \u1578 \u1610  \u1605 \u1608 \u1590 \u1608 \u1593 \u1607 \u1575  [\u1633 \u1636 \u1640 . \u1633 \u1636 \u1641 ] \u1588 \u1582 \u1589  \u1582 \u1575 \u1585 \u1580 \u1577  \u1593 \u1606  \u1589 \u1606 \u1575 \u1593 \u1577  \u1575 \u1604 \u1580 \u1583 \u1604 .\
\
(\uc0\u1634 /\u1633 \u1633 \u1640 ) \u1604 \u1603 \u1606  \u1602 \u1583  \u1610 \u1602 \u1608 \u1604  \u1602 \u1575 \u1574 \u1604  \u1601 \u1610  \u1605 \u1579 \u1604  \u1602 \u1608 \u1604 \u1606 \u1575  \'ab\u1607 \u1604  \u1575 \u1604 \u1605 \u1575 \u1588 \u1610  \u1581 \u1610 \u1608 \u1575 \u1606  (\u1633 )\'bb\u1548  \u1608 \'ab\u1607 \u1604  \u1575 \u1604 \u1590 \u1581 \u1575 \u1603  \u1573 \u1606 \u1587 \u1575 \u1606 \'bb\u1548  \u1608 \'ab\u1607 \u1604  \u1575 \u1604 \u1571 \u1576 \u1610 \u1590  \u1580 \u1587 \u1605 \'bb. \u1608 \u1610 \u1587 \u1578 \u1583 \u1604  \u1593 \u1606  \u1605 \u1593 \u1605 \u1608 \u1604 \u1575 \u1578  \u1571 \u1601 \u1593 \u1575 \u1604 \
\
\uc0\u1607 \u1584 \u1607  - \u1608 \u1607 \u1610  \u1603 \u1604 \u1607 \u1575  \u1580 \u1608 \u1575 \u1607 \u1585  \u1608 \u1605 \u1608 \u1590 \u1608 \u1593 \u1575 \u1578 \u1607 \u1575  \u1571 \u1593 \u1585 \u1575 \u1590  - \u1593 \u1604 \u1609  \u1571 \u1610  \u1588 \u1610 \u1569  \u1578 \u1583 \u1604 \u1617  \u1605 \u1606  \u1605 \u1608 \u1590 \u1608 \u1593 \u1575 \u1578 \u1607 \u1575 . [\u1576  \u1634 \u1636 \u1633  \u1608 ] \u1601 \u1607 \u1604  \u1578 \u1583 \u1604 \u1617  \u1605 \u1606 \u1607 \u1575  \u1593 \u1604 \u1609  \u1605 \u1575  \u1607 \u1608  \u1603 \u1604 \u1617  \u1608 \u1575 \u1581 \u1583  \u1605 \u1606 \u1607 \u1575  \u1571 \u1608  \u1593 \u1604 \u1609  \u1571 \u1588 \u1610 \u1575 \u1569  \u1582 \u1575 \u1585 \u1580 \u1577  \u1593 \u1606  \u1580 \u1608 \u1575 \u1607 \u1585 \u1607 \u1575 . \u1601 \u1573 \u1606  \u1603 \u1575 \u1606 \u1578  \u1578 \u1583 \u1604 \u1617  \u1593 \u1604 \u1609  \u1605 \u1575  \u1607 \u1608  \u1603 \u1604 \u1617  \u1608 \u1575 \u1581 \u1583  \u1605 \u1606 \u1607 \u1575  \u1604 \u1586 \u1605  \u1571 \u1606  \u1610 \u1603 \u1608 \u1606  \u1575 \u1604 \u1571 \u1576 \u1610 \u1590  \u1580 \u1608 \u1607 \u1585 \u1575 \u1611 \u1548  \u1608 \u1602 \u1583  \u1602 \u1610 \u1604  \u1601 \u1610 \u1605 \u1575  \u1578 \u1602 \u1583 \u1605  \u1573 \u1606 \u1617  \u1605 \u1575  \u1578 \u1583 \u1604 \u1617  \u1593 \u1604 \u1610 \u1607  \u1575 \u1604 \u1571 \u1587 \u1605 \u1575 \u1569  \u1575 \u1604 \u1605 \u1588 \u1578 \u1602 \u1577  \u1601 \u1607 \u1610  \u1603 \u1604 \u1607 \u1575  \u1571 \u1593 \u1585 \u1575 \u1590 . \u1608 \u1573 \u1606  \u1603 \u1575 \u1606 \u1578  \u1607 \u1584 \u1607  \u1575 \u1604 \u1605 \u1580 \u1605 \u1608 \u1593 \u1575 \u1578  \u1578 \u1593 \u1585 \u1601  \u1605 \u1606  \u1605 \u1608 \u1590 \u1608 \u1593 \u1575 \u1578 \u1607 \u1575  \u1571 \u1588 \u1610 \u1575 \u1569  \u1582 \u1575 \u1585 \u1580 \u1577  \u1593 \u1606  \u1583 \u1608 \u1575 \u1578 \u1607 \u1575  - \u1608 \u1603 \u1575 \u1606  \u1607 \u1584 \u1575  \u1607 \u1608  \u1585 \u1587 \u1605  \u1575 \u1604 \u1593 \u1585 \u1590  - \u1604 \u1586 \u1605  \u1571 \u1606  \u1610 \u1603 \u1608 \u1606  \u1575 \u1604 \u1573 \u1606 \u1587 \u1575 \u1606  \u1608 \u1575 \u1604 \u1581 \u1610 \u1608 \u1575 \u1606  \u1593 \u1585 \u1590 \u1575 \u1611 . \u1604 \u1603 \u1606  \u1593 \u1587 \u1609  \u1571 \u1606  \u1610 \u1603 \u1608 \u1606  \u1593 \u1585 \u1590 \u1575 \u1611  \u1576 \u1575 \u1604 \u1573 \u1590 \u1575 \u1601 \u1577  \u1573 \u1604 \u1609  \u1588 \u1610 \u1569  \u1570 \u1582 \u1585  \u1608 \u1580 \u1608 \u1607 \u1585 \u1607 \u1575  \u1576 \u1575 \u1604 \u1573 \u1590 \u1575 \u1601 \u1577  \u1573 \u1604 \u1609  \u1606 \u1601 \u1587 \u1607 . \u1608 \u1603 \u1584 \u1604 \u1603  \u1610 \u1603 \u1608 \u1606  \u1584 \u1604 \u1603  \u1601 \u1573 \u1584 \u1575  \u1604 \u1610 \u1587 \u1578  \u1578 \u1582 \u1578 \u1604 \u1591  \u1604 \u1604 \u1603 \u1604 \u1610 \u1575 \u1578  \u1575 \u1604 \u1580 \u1608 \u1575 \u1607 \u1585  \u1591 \u1576 \u1610 \u1593 \u1578 \u1607 \u1575  \u1605 \u1606  \u1581 \u1610 \u1579  \u1607 \u1610  \u1580 \u1608 \u1575 \u1607 \u1585 \u1548  \u1576 \u1604  \u1573 \u1578 \u1605 \u1575  \u1578 \u1603 \u1608 \u1606  \u1604 \u1607 \u1575  \u1607 \u1584 \u1607  \u1575 \u1604 \u1591 \u1576 \u1610 \u1593 \u1577  \u1576 \u1575 \u1604 \u1573 \u1590 \u1575 \u1601 \u1577  \u1573 \u1604 \u1609  \u1605 \u1608 \u1590 \u1608 \u1593 \u1575 \u1578 \u1607 \u1575 . \u1601 \u1610 \u1603 \u1608 \u1606  \u1604 \u1607 \u1575  \u1605 \u1608 \u1590 \u1608 \u1593 \u1575 \u1606 : \u1601 \u1610 \u1603 \u1608 \u1606  \u1580 \u1608 \u1607 \u1585 \u1575 \u1611  \u1604 \u1571 \u1581 \u1583  \u1605 \u1608 \u1590 \u1608 \u1593 \u1610 \u1607  \u1608 \u1593 \u1585 \u1590 \u1575 \u1611  \u1604 \u1571 \u1581 \u1583  \u1575 \u1604 \u1570 \u1582 \u1585 . \u1601 \u1573 \u1606  \u1603 \u1575 \u1606  \u1573 \u1578 \u1605 \u1575  \u1589 \u1575 \u1585  \u1580 \u1608 \u1607 \u1585 \u1575 \u1611  \u1604 \u1571 \u1581 \u1583  (\u1634 ) \u1605 \u1608 \u