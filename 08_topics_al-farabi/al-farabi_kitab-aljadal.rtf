\uc0\u1608 \u1605 \u1606 \u1607  \u1605 \u1575  \u1610 \u1615 \u1589 \u1575 \u1585  \u1601 \u1610 \u1607  \u1605 \u1606  \u1575 \u1604 \u1605 \u1587 \u1575 \u1608 \u1610  \u1573 \u1604 \u1609  \u1575 \u1604 \u1605 \u1587 \u1575 \u1608 \u1610  (\u1634 ) \u1603 \u1602 \u1608 \u1604 \u1606 \u1575  \'ab\u1603 \u1604  \u1573 \u1606 \u1587 \u1575 \u1606  \u1581 \u1605 \u1617 \u1605 \u1612  \u1633 \u1632 \u1632  \u1571 \u1608  [\u1633 \u1632 \u1632 ] \u1590 \u1581 \u1617 \u1575 \u1603  \u1608 \u1603 \u1604  \u1590 \u1581 \u1617 \u1575 \u1603  \u1602 \u1575 \u1576 \u1604  \u1604 \u1604 \u1593 \u1604 \u1605  \u1601 \u1603 \u1604  \u1573 \u1606 \u1587 \u1575 \u1606  \u1602 \u1575 \u1576 \u1604  \u1604 \u1604 \u1593 \u1604 \u1605 \'bb (\u1635 ).\
