(\uc0\u1634 /\u1633 \u1636 ) \u1608 \u1610 \u1578 \u1576 \u1610 \u1606 \u1607  (\u1633 ) \u1571 \u1606  \u1610 \u1603 \u1608 \u1606  \u1605 \u1576 \u1575 \u1583 \u1574  \u1575 \u1604 \u1606 \u1592 \u1585  \u1601 \u1610  \u1575 \u1604 \u1571 \u1605 \u1608 \u1585  \u1608 \u1575 \u1604 \u1601 \u1581 \u1589  \u1605 \u1606  \u1575 \u1604 \u1589 \u1583 \u1602  \u1608 \u1575 \u1604 \u1581 \u1602  (\u1634 ) \u1601 \u1610 \u1607 \u1575  \u1607 \u1610  \u1575 \u1604 \u1605 \u1602 \u1583 \u1605 \u1575 \u1578  \u1575 \u1604 \u1605 \u1588 \u1607 \u1608 \u1585 \u1577 \u1548  \u1573 \u1584  \u1603 \u1575 \u1606 \u1578  \u1575 \u1604 \u1588 \u1607 \u1585 \u1577  (\u1635 ) \u1575 \u1604 \u1608 \u1575 \u1585 \u1583 \u1577  (\u1636 ) \u1593 \u1604 \u1609  \u1575 \u1604 \u1606 \u1601 \u1587  \u1607 \u1610  \u1575 \u1604 \u1578 \u1610  (\u1637 ) \u1578 \u1585 \u1576 \u1591  \u1571 \u1581 \u1583  \u1580 \u1586 \u1574 \u1610  \u1575 \u1604 \u1605 \u1602 \u1583 \u1605 \u1577  \u1576 \u1575 \u1604 \u1570 \u1582 \u1585  \u1605 \u1606 \u1607 \u1605 \u1575  - \u1571 \u1593 \u1606 \u1610  \u1575 \u1604 \u1607 \u1605 \u1608 \u1604  \u1576 \u1575 \u1604 \u1605 \u1604 \u1608 \u1589 \u1608 \u1593  - \u1608 \u1610 \u1602 \u1593  (\u1638 ) \u1575 \u1604 \u1578 \u1589 \u1583 \u1610 \u1602  \u1576 \u1607 \u1575 . \u1608 \u1604 \u1571 \u1580 \u1604  (\u1639 ) \u1588 \u1607 \u1585 \u1578 \u1607 \u1575  \u1610 \u1571 \u1582 \u1584 \u1607  (\u1640 ) \u1575 \u1604 \u1573 \u1606 \u1587 \u1575 \u1606  \u1605 \u1575  \u1607 \u1608  \u1605 \u1606 \u1607 \u1575  (\u1641 ) \u1605 \u1585 \u1578 \u1576 \u1591  \u1601 \u1610  \u1575 \u1604 \u1606 \u1601 \u1587  \u1576 \u1573 \u1610 \u1580 \u1575 \u1576  \u1608 \u1593 \u1604 \u1609  \u1603 \u1605 \u1610 \u1577  \u1605 \u1575  \u1571 \u1606 \u1607  \u1571 \u1610 \u1590 \u1575 \u1611  \u1605 \u1608 \u1580 \u1576  \u1582 \u1575 \u1585 \u1580  \u1575 \u1604 \u1606 \u1601 \u1587  \u1608 \u1593 \u1604 \u1609  (\u1633 \u1632 ) \u1578 \u1604 \u1603  \u1575 \u1604 \u1603 \u16