> \uc0\u1575 \u1604 \u1605 \u1602 \u1583 \u1605 \u1577  \u1608 \u1575 \u1604 \u1605 \u1591 \u1604 \u1608 \u1576 \
\
(\uc0\u1639 \u1633 ) \u1575 \u1604 \u1605 \u1602 \u1583 \u1605 \u1577  (\u1633 ) \u1578 \u1602 \u1575 \u1604  \u1576 \u1575 \u1604 \u1593 \u1605 \u1608 \u1605  \u1593 \u1604 \u1609  \u1603 \u1604  \u1602 \u1590 \u1610 \u1577  \u1608 \u1593 \u1604 \u1609  \u1603 \u1604  \u1602 \u1608 \u1604  \u1580 \u1575 \u1586 \u1605  \u1576 \u1575 \u1604 \u1580 \u1605 \u1604 \u1577  (\u1634 )\u1548  \u1603 \u1575 \u1606 \u1578  \u1580 \u1586 \u1569  \u1602 \u1610 \u1575 \u1587  \u1571 \u1608  \u1605 \u1593 \u1583 \u1577  \u1604 \u1571 \u1606  \u1578 \u1572 \u1582 \u1584  (\u1635 ) \u1580 \u1586 \u1569  \u1602 \u1610 \u1575 \u1587  \u1571 \u1608  \u1606 \u1578 \u1610 \u1580 \u1577  \u1571 \u1608  \u1605 \u1591 \u1604 \u1608 \u1576 \u1548  \u1575 \u1587 \u1578 \u1593 \u1605 \u1604 \u1607 \u1575  \u1575 \u1604 \u1573 \u1606 \u1587 \u1575 \u1606  \u1601 \u1610 \u1605 \u1575  \u1576 \u1610 \u1606  \u1606 \u1601 \u1587 \u1607  \u1571 \u1608  \u1575 \u1587 \u1578 \u1593 \u1605 \u1604 \u1607 \u1575  \u1601 \u1610  \u1605 \u1582 \u1575 \u1591 \u1576 \u1577  \u1594 \u1610 \u1585 \u1607 \u1548  \u1608 \u1593 \u1604 \u1609  \u1607 \u1584 \u1575  \u1575 \u1604 \u1605 \u1593 \u1606 \u1609  \u1575 \u1587 \u1578 \u1593 \u1605 \u1604  \u1571 \u1585 \u1587 \u1591 \u1608 \u1591 \u1575 \u1604 \u1610 \u1576 \u1587  \u1604 \u1601 \u1592 \u1577  (\u1636 ) \u1575 \u1604 \u1605 \u1602 \u1583 \u1605 \u1577  \u1601 \u1610  \u1581 \u1604  (\u1637 ) \u1603 \u1578 \u1575 \u1576  \u1576 \u1575 \u1585 \u1610  \u1571 \u1585 \u1605 \u1610 \u1606 \u1610 \u1575 \u1587 . \u1608 \u1602 \u1583  \u1578 \u1602 \u1575 \u1604  \u1575 \u1604 \u1605 \u1602 \u1583 \u1605 \u1577  \u1571 \u1610 \u1590 \u1575 \u1611  \u1593 \u1604 \u1609  \u1575 \u1604 \u1602 \u1590 \u1610 \u1577  \u1575 \u1604 \u1578 \u1610  \u1610 \u1604 \u1578 \u1586 \u1605  \u1571 \u1581 \u1583 \u1607 \u1575  \u1576 \u1587 \u1572 \u1575 \u1604  (\u1639 ) \u1575 \u1604 \u1578 \u1602 \u1585 \u1610 \u1585  - \u1608 \u1607 \u1610  \u1575 \u1604 \u1605 \u1587 \u1572 \u1604  \u1605 \u1606 \u1607 \u1575  \u1576 \u1581 \u1585 \u1601  \u1575 \u1604 \u1578 \u1602 \u1585 \u1610 \u1585  - \u1603 \u1610 \u1601  \u1603 \u1575 \u1606 \u1578  (\u1640 ) \u1603 \u1575 \u1606 \u1578  \u1580 \u1586 \u1569  \u1602 \u1610 \u1575 \u1587  [\u1576 . \u1635 \u1634 ] \u1571 \u1608  \u1605 \u1593 \u1583 \u1577  \u1604 \u1584 \u1604 \u1603  \u1571 \u1608  \u1606 \u1578 \u1610 \u1580 \u1577  \u1571 \u1608  \u1605 \u1591 \u1604 \u1608 \u1576 \u1575 . \u1608 \u1575 \u1604 \u1605 \u1587 \u1571 \u1604 \u1577  \u1578 \u1602 \u1575 \u1604  \u1593 \u1604 \u1609  \u1603 \u1604  \u1602 \u1590 \u1610 \u1577  \u1605 \u1587 \u1572 \u1608 \u1604  \u1605 \u1606 \u1607 \u1575  \u1576 \u1581 \u1585 \u1601  (\u1641 ) \u1575 \u1604 \u1578 \u1582 \u1610 \u1610 \u1585  (\u1633 \u1632 ) - \u1608 \u1607 \u1610  \u1575 \u1604 \u1605 \u1601 \u1585 \u1608 \u1590  \u1576 \u1607 \u1575  \u1581 \u1585 \u1601  \u1575 \u1604 \u1578 \u1582 \u1610 \u1610 \u1585  (\u1633 \u1633 ) - \u1603 \u1610 \u1601  \u1603 \u1575 \u1606 \u1578  \u1575 \u1604 \u1602 \u1590 \u1610 \u1577 \u1548  \u1603 \u1575 \u1606 \u1578  (\u1633 \u1634 ) \u1580 \u1586 \u1569  \u1602 \u1610 \u1575 \u1587  \u1571 \u1608  \u1605 \u1593 \u1583 \u1577  \u1604 \u1584 \u1604 \u1603  \u1571 \u1608  \u1606 \u1578 \u1610 \u1580 \u1577  \u1571 \u1608  \u1605 \u1591 \u1604 \u1608 \u1576 \u1575 .\
\
(\uc0\u1639 \u1634 ) \u1575 \u1604 \u1605 \u1587 \u1572 \u1604  (\u1633 ) \u1605 \u1606 \u1607 \u1575  \u1576 \u1607 \u1584 \u1610 \u1606  \u1575 \u1604 \u1587 \u1572 \u1575 \u1604 \u1610 \u1606  \u1607 \u1610  \u1602 \u1590 \u1575 \u1610 \u1575  \u1608 \u1575 \u1581 \u1583 \u1577  \u1576 \u1571 \u1605 \u1610 \u1575 \u1606 \u1607 \u1575  \u1608 \u1573 \u1606 \u1605 \u1575  \u1578 \u1582 \u1578 \u1604 \u1601  \u1601 \u1610  \u1580 \u1607 \u1577  \u1575 \u1604 \u1587 \u1572 \u1575 \u1604  \u1601 \u1602 \u1591  \u1601 \u1578 \u1587 \u1605 \u1609  \u1605 \u1602 \u1583 \u1605 \u1575 \u1578  \u1608 \u1605 \u1587 \u1575 \u1574 \u1604  (\u1634 ) \u1604 \u1610 \u1587 \
\
\uc0\u1604 \u1588 \u1610 \u1569  (\u1635 ) \u1571 \u1603 \u1579 \u1585  \u1605 \u1606  \u1571 \u1606  \u1604 \u1601 \u1592  \u1575 \u1604 \u1605 \u1602 \u1583 \u1605 \u1575 \u1578  \u1610 \u1583 \u1604  \u1605 \u1606 \u1607 \u1575  \u1593 \u1604 \u1609  \u1580 \u1607 \u1577  \u1605 \u1575  \u1605 \u1606  \u1580 \u1607 \u1575 \u1578  \u1575 \u1604 \u1587 \u1572 \u1575 \u1604  \u1605 \u1606 \u1607 \u1575 \u1548  \u1608 \u1610 \u1576 \u1583 \u1604  \u1604 \u1601 \u1592  \u1575 \u1604 \u1605 \u1587 \u1575 \u1574 \u1604  \u1605 \u1606 \u1607 \u1575  \u1576 \u1571 \u1593 \u1610 \u1575 \u1606 \u1607 \u1575  \u1593 \u1604 \u1609  \u1580 \u1607 \u1577  \u1571 \u1582 \u1585 \u1609  \u1604 \u1604 \u1587 \u1572 \u1575 \u1604  \u1605 \u1606 \u1607 \u1575  (\u1636 ). \u1601 \u1575 \u1604 \u1605 \u1602 \u1583 \u1605 \u1577  (\u1607 ) \u1593 \u1604 \u1609  \u1607 \u1584 \u1575  \u1575 \u1604 \u1608 \u1580 \u1607  \u1607 \u1610  \u1575 \u1604 \u1602 \u1590 \u1610 \u1577  \u1575 \u1604 \u1578 \u1610  \u1588 \u1603 \u1604  \u1604 \u1601 \u1592  \u1575 \u1604 \u1587 \u1572 \u1575 \u1604  (\u1638 ) \u1593 \u1606 \u1607 \u1575  \u1588 \u1603 \u1604  \u1605 \u1575  \u1607 \u1610  \u1605 \u1602 \u1585 \u1617  \u1576 \u1607 \u1575  \u1571 \u1608  \u1605 \u1575  \u1607 \u1610  \u1576 \u1610 \u1574 \u1577  \u1571 \u1608  \u1588 \u1603 \u1604  \u1605 \u1575  \u1587 \u1576 \u1610 \u1604 \u1607 \u1575  \u1571 \u1606  \u1610 \u1593 \u1578 \u1585 \u1601  (\u1639 ) \u1576 \u1607 \u1575  \u1575 \u1604 \u1605 \u1587 \u1572 \u1608 \u1604  (\u1640 ) - \u1587 \u1608 \u1575 \u1569  \u1603 \u1575 \u1606 \u1578  \u1603 \u1584 \u1604 \u1603  \u1601 \u1610  \u1606 \u1601 \u1587 \u1607 \u1575  \u1571 \u1605  \u1604 \u1575 . \u1608 \u1575 \u1604 \u1605 \u1587 \u1571 \u1604 \u1577  \u1593 \u1604 \u1609  \u1607 \u1584 \u1607  \u1575 \u1604 \u1580 \u1607 \u1577  \u1607 \u1610  \u1575 \u1604 \u1602 \u1590 \u1610 \u1577  \u1575 \u1604 \u1578 \u1610  \u1588 \u1603 \u1604  \u1606 \u1601 \u1587  \u1575 \u1604 \u1587 \u1572 \u1575 \u1604  \u1593 \u1606 \u1607 \u1575  \u1588 \u1603 \u1604  \u1605 \u1575  \u1607 \u1608  \u1605 \u1591 \u1604 \u1608 \u1576  \u1594 \u1610 \u1585  (\u1641 ) \u1576 \u1610 \u1606  \u1571 \u1608  \u1588 \u1603 \u1604  \u1605 \u1575  \u1607 \u1608  \u1605 \u1588 \u1603 \u1608 \u1603  \u1601 \u1610 \u1607  \u1587 \u1608 \u1575 \u1569  \u1603 \u1575 \u1606 \u1578  \u1603 \u1584 \u1604 \u1603 * (\u1633 \u1632 ). \u1608 \u1601 \u1610  \u1606 \u1601 \u1587 \u1607 \u1575  \u1571 \u1605  \u1604 \u1575 . \u1608 \u1593 \u1604 \u1609  \u1607 \u1584 \u1575  \u1575 \u1604 \u1605 \u1593 \u1606 \u1609  \u1602 \u1575 \u1604  \u1571 \u1585 \u1587 \u1591 \u1608 \u1591 \u1575 \u1604 \u1610 \u1610 \u1587  \u1601 \u1610  \u1571 \u1608 \u1604  \u1575 \u1604 \u1605 \u1602 \u1575 \u1604 \u1577  \u1575 \u1604 \u1571 \u1608 \u1604 \u1609  \u1605 \u1606  \u1603 \u1578 \u1575 \u1576  \u1575 \u1604 \u1580 \u1583 \u1604  \'ab\u1608 \u1575 \u1604 \u1605 \u1587 \u1571 \u1604 \u1577  \u1573 \u1606 \u1605 \u1575  \u1578 \u1582 \u1578 \u1604 \u1601  \u1575 \u1604 \u1605 \u1602 \u1583 \u1605 \u1577  \u1576 \u1575 \u1604 \u1580 \u1607 \u1577  \u1608 \u1584 \u1604 \u1603  \u1571 \u1606  \u1607 \u1584 \u1575  \u1575 \u1604 \u1602 \u1608 \u1604  \u1573 \u1584 \u1575  \u1602 \u1610 \u1604  \u1593 \u1604 \u1609  \u1607 \u1584 \u1607  \u1575 \u1604 \u1580 \u1607 \u1577  \u1571 \u1604 \u1610 \u1587  \u1602 \u1608 \u1604 \u1606 \u1575  "\u1607 \u1610  \u1605 \u1579 \u1617 \u1575 \u1569  \u1584 \u1608  \u1585 \u1580 \u1604 \u1610 \u1606 " \u1607 \u1584 \u1575  \u1604 \u1604 \u1573 \u1606 \u1587 \u1575 \u1606  (\u1633 \u1633 )\u1548  \u1610 \u1603 \u1608 \u1606  \u1605 \u1602 \u1583 \u1605 \u1577 \u1548  \u1608 \u1603 \u1584 \u1604 \u1603  \u1573 \u1584 \u1575  (\u1633 \u1634 ) \u1602 \u1610 \u1604  "\u1571 \u1604 \u1610 \u1587  \u1575 \u1604 \u1581 \u1605 \u1609  \u1580 \u1606 \u1587 \u1575 \u1611 " (\u1633 \u1635 ) \u1604 \u1604 \u1573 \u1606 \u1587 \u1575 \u1606  \u1603 \u1575 \u1606  \u1605 \u1602 \u1583 \u1605 \u1577  (\u1633 \u1636 ). \u1601 \u1573 \u1606  (\u1607 ) (\u1633 ) [\u1581 \u1580 \u1577 \u1641 \u1641 \u1592 ] \u1602 \u1610 \u1604  \u1607 \u1604  \u1602 \u1608 \u1604 \u1606 \u1575  "\u1607 \u1610  \u1605 \u1579 \u1617 \u1575 \u1569  \u1584 \u1608  \u1585 \u1580 \u1604 \u1610 \u1606 " \u1607 \u1584 \u1575  \u1604 \u1604 \u1573 \u1606 \u1587 \u1575 \u1606  (\u1633 \u1638 ) \u1571 \u1605  \u1604 \u1575 \u1548  \u1603 \u1575 \u1606  \u1605 \u1587 \u1571 \u1604 \u1577 . \u1608 \u1593 \u1604 \u1609  \u1607 \u1584 \u1575  (\u1633 \u1639 ) \u1575 \u1604 \u1605 \u1579 \u1575 \u1604  \u1610 \u1580 \u1585 \u1610  \u1575 \u1604 \u1571 \u1605 \u1585  \u1601 \u1610  \u1587 \u1575 \u1574 \u1585  \u1575 \u1604 \u1571 \u1588 \u1610 \u1575 \u1569  \u1575 \u1604 \u1570 \u1582 \u1585 . \u1601 \u1576 \u1575 \u1604 \u1608 \u1575 \u1580 \u1576  \u1589 \u1575 \u1585 \u1578  \u1575 \u1604 \u1605 \u1587 \u1575 \u1574 \u1604  \u1608 \u1575 \u1604 \u1605 \u1602 \u1583 \u1605 \u1575 \u1578  \u1605 \u1578 \u1587 \u1575 \u1608 \u1610 \u1577  \u1601 \u1610  \u1575 \u1604 \u1593 \u1583 \u1583  \u1608 \u1608 \u1575 \u1581 \u1583 \u1577  (\u1633 \u1640 ) [\u1576 .\u1634 \u1634 \u1592 ] \u1576 \u1571 \u1593 \u1610 \u1575 \u1606 \u1607 \u1575 . \u1608 \u1584 \u1604 \u1603  \u1571 \u1606 \u1603  \u1602 \u1583  \u1578 \u1593 \u1605 \u1604  \u1605 \u1606  \u1603 \u1604  \u1605 \u1602 \u1583 \u1605 \u1577  \u1605 \u1587 \u1571 \u1604 \u1577  \u1573 \u1584 \u1575  \u1606 \u1602 \u1604 \u1578 \u1607 \u1575  \u1593 \u1606  \u1580 \u1607 \u1578 \u1607 \u1575 .\
\
(\uc0\u1639 \u1635 ) \u1608 \u1602 \u1583  \u1610 \u1602 \u1575 \u1604  \u1575 \u1604 \u1605 \u1602 \u1583 \u1605 \u1577  \u1576 \u1608 \u1580 \u1607  \u1571 \u1582 \u1589  \u1605 \u1606  \u1575 \u1604 \u1571 \u1608 \u1604  \u1593 \u1604 \u1609  \u1603 \u1604  \u1602 \u1590 \u1610 \u1577  \u1580 \u1593 \u1604 \u1578  \u1580 \u1586 \u1569 \
\
\uc0\u1602 \u1610 \u1575 \u1587  \u1571 \u1608  \u1603 \u1575 \u1606 \u1578  \u1605 \u1593 \u1583 \u1577  \u1604 \u1571 \u1606  \u1578 \u1580 \u1593 \u1604  \u1580 \u1586 \u1569  \u1602 \u1610 \u1575 \u1587  \u1601 \u1610  \u1571 \u1610  \u1589 \u1606 \u1575 \u1593 \u1577  \u1603 \u1575 \u1606 \u1578 \u1548  \u1608 \u1575 \u1604 \u1605 \u1587 \u1571 \u1604 \u1577  \u1578 \u1602 \u1575 \u1604 \
\
