\
(\uc0\u1633 \u1634 \u1634 ) \u1608 \u1604 \u1610 \u1587  \u1575 \u1604 \u1575 \u1587 \u1578 \u1602 \u1585 \u1575 \u1569  \u1607 \u1608  \u1575 \u1604 \u1605 \u1589 \u1610 \u1585  \u1605 \u1606  \u1571 \u1588 \u1610 \u1575 \u1569  (\u1633 ) \u1603 \u1579 \u1610 \u1585 \u1577  \u1573 \u1604 \u1609  \u1588 \u1610 \u1569  \u1608 \u1575 \u1581 \u1583  \u1601 \u1573 \u1606  \u1607 \u1584 \u1575  \u1591 \u1585 \u1610 \u1602  \u1571 \u1582 \u1584  (\u1634 ) \u1605 \u1606  \u1580 \u1586 \u1574 \u1610 \u1575 \u1578  \u1605 \u1578 \u1588 \u1575 \u1576 \u1607 \u1577  \u1573 \u1604 \u1609  \u1580 \u1586 \u1574 \u1610  \u1570 \u1582 \u1585  \u1588 \u1576 \u1610 \u1607  \u1576 \u1607 \u1575 \u1548  \u1601 \u1607 \u1608  \u1605 \u1589 \u1610 \u1585  \u1605 \u1606  \u1580 \u1586 \u1574 \u1610  \u1573 \u1604 \u1609  \u1580 \u1586 \u1574 \u1610  \u1608 \u1607 \u1608  \u1583 \u1575 \u1582 \u1604  \u1601 \u1610  \u1580 \u1605 \u1604 \u1577  \u1575 \u1604 \u1605 \u1579 \u1604 \u1575 \u1617 \u1578  \u1608 \u1575 \u1604 \u1605 \u1579 \u1604 \u1575 \u1617 \u1578  \u1603 \u1604 \u1607 \u1575  \u1582 \u1591 \u1610 \u1576 \u1617 \u1577  \u1603 \u1575 \u1606 \u1578  \u1571 \u1582 \u1584 \u1577  (\u1635 ) \u1605 \u1606  \u1580 \u1586 \u1574 \u1610 \u1575 \u1578  \u1603 \u1579 \u1610 \u1585 \u1577  \u1573 \u1604 \u1609  \u1580 \u1586 \u1574 \u1610  \u1608 \u1575 \u1581 \u1583  \u1571 \u1608  \u1571 \u1582 \u1584 \u1577  (\u1636 ) \u1605 \u1606  \u1580 \u1586 \u1574 \u1610  \u1608 \u1575 \u1581 \u1583  \u1573 \u1604 \u1609  \u1580 \u1586 \u1574 \u1610  \u1608 \u1575 \u1581 \u1583  \u1594 \u1610 \u1585  \u1571 \u1606 \u1607  \u1603 \u1579 \u1610 \u1585  \u1605 \u1575  \u1610 \u1578 \u1601 \u1602  \u1571 \u1606  \u1610 \u1587 \u1578 \u1602 \u1585 \u1617  \u1571 \u1588 \u1610 \u1575 \u1569  (\u1607 ) \u1603 \u1579 \u1610 \u1585 \u1577  \u1608 \u1604 \u1575  \u1610 \u1587 \u1578 \u1608 \u1601 \u1610  \u1580 \u1605 \u1610 \u1593 \u1607 \u1575 . \u1608 \u1578 \u1603 \u1608 \u1606  \u1578 \u1604 \u1603  \u1605 \u1606  \u1575 \u1604 \u1571 \u1588 \u1610 \u1575 \u1569  (\u1638 ) \u1575 \u1604 \u1578 \u1610  \u1573 \u1606 \u1605 \u1575  (\u1639 ) \u1610 \u1615 \u1593 \u1585 \u1601  \u1578 \u1588 \u1575 \u1576 \u1607 \u1607 \u1575  \u1576 \u1575 \u1604 \u1590 \u1605 \u1610 \u1585  \u1605 \u1606  \u1594 \u1610 \u1585  \u1571 \u1606  \u1610 \u1608 \u1580 \u1583  \u1575 \u1587 \u1605  \u1610 \u1593 \u1605 \u1617 \u1607 \u1575  \u1603 \u1604 \u1607 \u1575  \u1605 \u1606  \u1581 \u1610 \u1579  \u1607 \u1610  \u1605 \u1578 \u1588 \u1575 \u1576 \u1607 \u1577 \u1548  \u1571 \u1608  \u1578 \u1603 \u1608 \u1606  \u1605 \u1606  \u1575 \u1604 \u1605 \u1578 \u1588 \u1575 \u1576 \u1607 \u1577  \u1575 \u1604 \u1578 \u1610  \u1604 \u1605  \u1610 \u1578 \u1601 \u1602  \u1571 \u1606  \u1610 \u1578 \u1601 \u1602 \u1585  (\u1640 ) \u1601 \u1610  \u1575 \u1604 \u1606 \u1601 \u1587  \u1575 \u1604 \u1605 \u1593 \u1606 \u1609  \u1575 \u1604 \u1584 \u1610  \u1576 \u1607  \u1578 \u1588 \u1575 \u1576 \u1607 \u1578 . \u1601 \u1610 \u1581 \u1578 \u1575 \u1580  \u1575 \u1604 \u1602 \u1575 \u1574 \u1604  \u1593 \u1606 \u1583 \u1607 \u1575  \u1571 \u1606  \u1610 \u1602 \u1608 \u1604  \'ab\u1608 \u1603 \u1584 \u1604 \u1603  \u1587 \u1575 \u1574 \u1585 \u1607 \u1575 \'bb.\
