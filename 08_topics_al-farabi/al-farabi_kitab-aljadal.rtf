(\uc0\u1634 \u1634 ) \u1608 \u1605 \u1606 \u1607 \u1575  \u1571 \u1606  \u1575 \u1604 \u1593 \u1604 \u1608 \u1605  \u1575 \u1604 \u1605 \u1602 \u1610 \u1587 \u1610 \u1577  \u1607 \u1585 \u1576 \u1575 \u1606 \u1548  \u1607 \u1585 \u1576  \u1605 \u1608 \u1589 \u1608 \u1605 \u1575 \u1606 \u1607  \u1607 \u1610  \u1575 \u1604 \u1578 \u1610  \u1578 \u1585 \u1588 \u1583  \u1575 \u1604 \u1573 \u1606 \u1587 \u1575 \u1606  \u1575 \u1604 \u1606 \u1575 \u1592 \u1585  \u1601 \u1610 \u1607  \u1608 \u1575 \u1604 \u1602 \u1575 \u1590 \u1610  \u1605 \u1606 \u1607  \u1573 \u1604 \u1609  \u1575 \u1604 \u1589 \u1608 \u1575 \u1576  \u1576 \u1587 \u1607 \u1608 \u1604 \u1578 \u1607 \u1575  \u1593 \u1604 \u1609  \u1575 \u1604 \u1584 \u1607 \u1606  \u1608 \u1587 \u1585 \u1593 \u1577  \u1578 \u1582 \u1604 \u1589 \u1607 \u1575  \u1601 \u1610  \u1575 \u1604 \u1606 \u1601 \u1587  \u1605 \u1606  \u1575 \u1604 \u1571 \u1605 \u1585 \u1575 \u1590  \u1575 \u1604 \u1578 \u1610  \u1578 \u1601 \u1575 \u1585 \u1578 \u1607 \u1575 \u1548  \u1608 \u1604 \u1571 \u1606 \u1607 \u1575  \u1605 \u1610 \u1587 \u1578 \u1585 \u1617 \u1577  (\u1633 ) \u1601 \u1610  \u1583 \u1608 \u1575 \u1574 \u1607 \u1575  \u1604 \u1571 \u1606  \u1610 \u1606 \u1581 \u1603 \u1610 \u1607 \u1575  \u1575 \u1604 \u1573 \u1606 \u1587 \u1575 \u1606  \u1608 \u1610 \u1606 \u1589 \u1608 \u1617 \u1585 \u1607 \u1575  \u1605 \u1580 \u1585 \u1617 \u1583 \u1577  \u1605 \u1606  \u1575 \u1604 \u1605 \u1570 \u1601 \u1577  \u1605 \u1606  \u1594 \u1610 \u1585  \u1571 \u1606  \u1610 \u1581 \u1608 \u1580  \u1575 \u1604 \u1573 \u1606 \u1587 \u1575 \u1606  \u1601 \u1610 \u1607 \u1575  \u1573 \u1604 \u1609  \u1602 \u1608 \u1577  \u1605 \u1606  \u1583 \u1607 \u1606 \u1607  \u1603 \u1576 \u1610 \u1585 \u1617 \u1577  (\u1634 ) - \u1608 \u1584 \u1604 \u1603  \u1593 \u1604 \u1608 \u1605  \u1575 \u1604 \u1578 \u1593 \u1575 \u1604 \u1610 \u1605 \u1548  \u1608 \u1607 \u1585 \u1576  \u1605 \u1608 \u1589 \u1608 \u1605 \u1575 \u1606 \u1607  \u1601 \u1606 \u1617 \u1593  (\u1635 ) \u1580 \u1575 \u1606 \u1576  \u1575 \u1604 \u1589 \u1608 \u1575 \u1576  \u1601 \u1610 \u1607  \u1604 \u1593 \u1587 \u1585  (\u1636 ) \u1578 \u1582 \u1604 \u1589 \u1607 \u1575  (\u1637 ) \u1601 \u1610  \u1575 \u1604 \u1584 \u1607 \u1606  \u1605 \u1606  \u1575 \u1604 \u1605 \u1570 \u1601 \u1577  \u1576 \u1604  \u1573 \u1606 \u1607 \u1575  \u1604 \u1575  \u1578 \u1578 \u1581 \u1604 \u1617 \u1589  \u1608 \u1573 \u1606 \u1605 \u1575  (\u1638 ) \u1578 \u1601 \u1607 \u1605  \u1571 \u1576 \u1583 \u1575 \u1611  \u1605 \u1593  \u1605 \u1608 \u1575 \u1578 \u1607 \u1575  \u1608 \u1601 \u1610  \u1605 \u1608 \u1575 \u1578 \u1607 \u1575 . \u1601 \u1583 \u1604 \u1617 \u1604 \u1606 \u1575  (\u1639 ) \u1604 \u1575  \u1610 \u1572 \u1605 \u1606 \u1548  \u1573 \u1584 \u1575  \u1603 \u1575 \u1606 \u1578  \u1601 \u1610  \u1575 \u1604 \u1605 \u1608 \u1570 \u1584  \u1575 \u1604 \u1571 \u1605 \u1585 \u1575 \u1590  \u1603 \u1579 \u1610 \u1585 \u1617 \u1577 \u1548  \u1571 \u1606  (\u1640 ) \u1610 \u1602 \u1578 \u1585 \u1608 \u1606  \u1576 \u1607 \u1575  \u1593 \u1606 \u1583  \u1601 \u1607 \u1605 \u1606 \u1575  (\u1641 ) \u1604 \u1607 \u1575  \u1578 \u1604 \u1603  \u1575 \u1604 \u1571 \u1605 \u1585 \u1575 \u1590  \u1601 \u1578 \u1614 \u1591 \u1618 \u1604 \u1616 \u1610 \u1593  \u1575 \u1604 \u1606 \u1575 \u1592 \u1585 \u1610 \u1606  \u1605 \u1606  \u1575 \u1604 \u1581 \u1602 \u1617  \u1601 \u1610  \u1578 \u1604 \u1603  \u1575 \u1604 \u1571 \u1588 \u1610 \u1575 \u1569 \u1548  \u1608 \u1610 \u1615 \u1587 \u1618 \u1578 \u1614 \u1581 \u1618 \u1603 \u1614 \u1604  \u1575 \u1604 \u1588 \u1610 \u1569  \u1575 \u1604 \u1608 \u1575 \u1581 \u1583  \u1604 \u1604 \u1606 \u1575 \u1592 \u1585 \u1610 \u1606  \u1601 \u1610 \u1607  \u1593 \u1604 \u1609  \u1571 \u1581 \u1608 \u1575 \u1604  \u1605 \u1578 \u1602 \u1575 \u1576 \u1604 \u1577  \u1601 \u1606 \u1585 \u1601 \u1602 \u1607 \u1605  (\u1633 \u1632 ) \u1601 \u1610  \u1591 \u1606 \u1608 \u1606  \u1605 \u1606 \u1590 \u1575 \u1583 \u1577  \u1601 \u1610 \u1578 \u1606 \u1575 \u1586 \u1605 \u1608 \u1606  (\u1576 ) [\u1634 \u1632 \u1637 ] \u1601 \u1610 \u1607 \u1575  (\u1633 \u1633 ) \u1575 \u1604 \u1571 \u1585 \u1575 \u1569 \u1548  \u1608 \u1588 \u1580 \u1617 \u1585 \u1607 \u1605  (\u1633 \u1634 ) \u1604 \u1571 \u1606 \u1607 \u1575 \u1548  \u1573 \u1584 \u1575  \u1604 \u1605  \u1578 \u1578 \u1581 \u1604 \u1617 \u1589  \u1575 \u1604 \u1605 \u1593 \u1575 \u1606 \u1610  \u1601 \u1610  \u1575 \u1604 \u1606 \u1601 \u1587  \u1605 \u1580 \u1585 \u1617 \u1583 \u1577  \u1605 \u1606  \u1575 \u1604 \u1605 \u1570 \u1601 \u1577  \u1608 \u1605 \u1606  \u1575 \u1604 \u1571 \u1605 \u1585 \u1575 \u1590  \u1575 \u1604 \u1578 \u1610  \u1578 \u1601 \u1575 \u1585 \u1578 \u1607 \u1575 \u1548  \u1604 \u1605  \u1578 \u1578 \u1581 \u1604 \u1617 \u1589  (\u1633 \u1635 ) \u1601 \u1610  \u1575 \u1604 \u1605 \u1602 \u1578 \u1590 \u1575 \u1578  \u1575 \u1604 \u1571 \u1608 \u1604 \u1609  \u1605 \u1606  \u1571 \u1608 \u1604  \u1575 \u1604 \u1571 \u1605 \u1585  \u1603 \u1604 \u1610 \u1575 \u1578 \u1607 \u1575 . \u1604 \u1571 \u1606  \u1575 \u1604 \u1571 \u1605 \u1608 \u1585  \u1575 \u1604 \u1605 \u1593 \u1602 \u1608 \u1604 \u1577 \
\
\uc0\u1605 \u1579 \u1604 \u1575 \u1611  \u1604 \u1605  \u1578 \u1606 \u1605 \u1617 \u1585  \u1576 \u1593 \u1590 \u1607 \u1575  \u1593 \u1606  \u1576 \u1593 \u1590  \u1601 \u1610  \u1575 \u1604 \u1606 \u1601 \u1587  \u1602 \u1576 \u1610 \u1581 \u1575 \u1611  \u1578 \u1575 \u1605 \u1575 \u1611  \u1581 \u1578 \u1609  \u1610 \u1582 \u1604 \u1589  \u1603 \u1604 \u1617  \u1608 \u1575 \u1581 \u1583  \u1605 \u1606 \u1607 \u1575  \u1601 \u1610  \u1575 \u1604 \u1584 \u1607 \u1606  \u1576 \u1591 \u1576 \u1610 \u1593 \u1578 \u1607  \u1575 \u1604 \u1578 \u1610  \u1578 \u1582 \u1589 \u1617 \u1607  \u1605 \u1580 \u1585 \u1617 \u1583 \u1577  \u1604 \u1605  \u1610 \u1582 \u1604 \u1589  \u1575 \u1604 \u1605 \u1608 \u1590 \u1608 \u1593  \u1601 \u1610 \u1607 \u1575  \u1605 \u1608 \u1590 \u1608 \u1593 \u1575 \u1611  \u1604 \u1604 \u1605 \u1581 \u1605 \u1608 \u1604  \u1601 \u1610 \u1607 \u1575  (\u1633 \u1636 ) \u1603 \u1604 \u1617 \u1610 \u1575 \u1611  \u1593 \u1604 \u1609  \u1575 \u1604 \u1578 \u1605 \u1575 \u1605  \u1576 \u1604  \u1610 \u1576 \u1602 \u1609  \u1601 \u1610 \u1607  \u1605 \u1608 \u1590 \u1608 \u1593  \u1588 \u1585 \u1591 \u1610 \u1577  \u1605 \u1575  \u1571 \u1608  \u1588 \u1585 \u1575 \u1574 \u1591  \u1608 \u1610 \u1615 \u1587 \u1578 \u1593 \u1605 \u1604  \u1601 \u1610  \u1571 \u1608 \u1604  \u1575 \u1604 \u1571 \u1605 \u1585  \u1593 \u1604 \u1609  \u1571 \u1603 \u1579 \u1585  \u1605 \u1575  \u1610 \u1605 \u1603 \u1606  \u1575 \u1604 \u1573 \u1606 \u1587 \u1575 \u1606  \u1605 \u1606  \u1575 \u1604 \u1578 \u1582 \u1604 \u1617 \u1589  \u1573 \u1604 \u1609  \u1571 \u1606  \u1578 \u1585 \u1583  \u1576 \u1593 \u1583  \u1584 \u1604 \u1603  (\u1633 ) \u1575 \u1604 \u1605 \u1593 \u1575 \u1606 \u1583 \u1575 \u1578  [\u1581 \u1641 \u1632 .\u1592 ] \u1601 \u1606 \u1581 \u1604 \u1617 \u1589 \u1607 .\
\
(\uc0\u1634 \u1634 ) \u1608 \u1571 \u1610 \u1590 \u1575 \u1611  \u1601 \u1573 \u1606  \u1575 \u1604 \u1571 \u1605 \u1585 \u1548  \u1605 \u1579 \u1604 \u1575 \u1611  \u1575 \u1601 \u1578 \u1585 \u1606 \u1578  \u1573 \u1604 \u1610 \u1607  \u1605 \u1575 \u1583 \u1577  \u1571 \u1608  \u1605 \u1585 \u1590  \u1605 \u1606  \u1575 \u1604 \u1571 \u1605 \u1585 \u1575 \u1590  \u1608 \u1607 \u1605 \u1617 \u1585  \u1578 \u1589 \u1608 \u1617 \u1585 \u1607 \u1575  (\u1633 ) - \u1571 \u1608  \u1604 \u1605  \u1610 \u1605 \u1603 \u1606  - \u1583 \u1608 \u1606  \u1575 \u1604 \u1605 \u1575 \u1583 \u1577  \u1608 \u1583 \u1608 \u1606  \u1578 \u1604 \u1603  (\u1634 ) \u1575 \u1604 \u1571 \u1605 \u1585 \u1575 \u1590 \u1548  \u1571 \u1605 \u1603 \u1606  \u1571 \u1606  \u1610 \u1603 \u1608 \u1606  \u1575 \u1604 \u1605 \u1581 \u1605 \u1608 \u1604  \u1593 \u1604 \u1609  \u1584 \u1604 \u1603  \u1575 \u1604 \u1588 \u1610 \u1569 \u1548  \u1605 \u1606  \u1581 \u1610 \u1579  \u1607 \u1608  \u1605 \u1601 \u1585 \u1583  \u1576 \u1591 \u1576 \u1610 \u1593 \u1578 \u1607  \u1605 \u1581 \u1605 \u1608 \u1604 \u1575 \u1611  \u1605 \u1575  (\u1635 ) \u1608 \u1573 \u1584 \u1575  \u1571 \u1582 \u1584  \u1605 \u1606  \u1581 \u1610 \u1579  \u1607 \u1608  \u1605 \u1608 \u1590 \u1608 \u1593  \u1576 \u1576 \u1606 \u1603  \u1575 \u1604 \u1605 \u1575 \u1583 \u1617 \u1577 \u1548  \u1603 \u1575 \u1606  \u1605 \u1581 \u1605 \u1608 \u1604 \u1575 \u1611  \u1589 \u1583 \u1617  \u1605 \u1581 \u1605 \u1608 \u1604 \u1575 \u1611 . \u1601 \u1573 \u1584 \u1575  \u1604 \u1605  \u1610 \u1606 \u1578 \u1605 \u1617 \u1585  \u1604 \u1606 \u1575  \u1584 \u1604 \u1603  (\u1636 ) \u1575 \u1604 \u1588 \u1610 \u1569 \u1548  \u1605 \u1606  \u1581 \u1610 \u1579  \u1607 \u1608  \u1605 \u1601 \u1585 \u1583  \u1593 \u1606  \u1606 \u1601 \u1587 \u1607  \u1608 \u1605 \u1606  (\u1637 ) \u1581 \u1610 \u1579  \u1607 \u1608  \u1605 \u1602 \u1578 \u1585 \u1606  \u1580 \u1605 \u1575 \u1593 \u1577  \u1608 \u1575 \u1582 \u1584 \u1606 \u1575 \u1607  \u1576 \u1581 \u1575 \u1604  \u1608 \u1575 \u1581 \u1583 \u1577 \u1548  \u1581 \u1602  \u1584 \u1604 \u1603  \u1575 \u1604 \u1588 \u1610 \u1569 \u1548  \u1575 \u1604 \u1608 \u1575 \u1581 \u1583  \u1605 \u1581 \u1605 \u1608 \u1604 \u1575 \u1606  \u1605 \u1578 \u1590 \u1575 \u1583 \u1617 \u1575 \u1606 . \u1608 \u1603 \u1584 \u1604 \u1603  \u1573 \u1584 \u1575  \u1603 \u1575 \u1606  \u1575 \u1604 \u1605 \u1602 \u1578 \u1585 \u1606  \u1576 \u1607  \u1605 \u1585 \u1589 \u1575 \u1611  \u1605 \u1575  \u1601 \u1610  \u1575 \u1604 \u1605 \u1575 \u1583 \u1577 \u1548  \u1608 \u1604 \u1605  (\u1638 ) \u1578 \u1606 \u1605 \u1617 \u1585  \u1604 \u1606 \u1575  \u1584 \u1575 \u1578 \u1607  \u1605 \u1580 \u1585 \u1617 \u1583 \u1577  \u1605 \u1606  \u1584 \u1575 \u1578 \u1607  \u1605 \u1606  \u1581 \u1610 \u1579  \u1607 \u1608  \u1605 \u1602 \u1578 \u1585 \u1606  \u1576 \u1584 \u1604 \u1603  \u1575 \u1604 \u1593 \u1585 \u1590  \u1608 \u1603 \u1575 \u1606  (\u1639 ) \u1610 \u1604 \u1581 \u1602 \u1607  \u1604 \u1571 \u1580 \u1604  \u1581 \u1575 \u1604 \u1607  (\u1640 ) \u1605 \u1581 \u1605 \u1608 \u1604 \u1575 \u1606  \u1605 \u1578 \u1590 \u1575 \u1583 \u1617 \u1575 \u1606 . \u1608 \u1603 \u1584 \u1604 \u1603  \u1573 \u1584 \u1575  \u1603 \u1575 \u1606  \u1605 \u1602 \u1578 \u1585 \u1606 \u1575 \u1611  \u1576 \u1593 \u1585 \u1590 \u1610 \u1606  \u1608 \u1603 \u1575 \u1606  (\u1641 ) \u1610 \u1604 \u1581 \u1602  \u1603 \u1604 \u1617  \u1608 \u1575 \u1581 \u1583  \u1605 \u1606  \u1575 \u1604 \u1593 \u1585 \u1590 \u1610 \u1606  \u1605 \u1581 \u1605 \u1608 \u1604 \u1575 \u1611  (\u1633 \u1632 ) \u1589 \u1583 \u1617  \u1575 \u1604 \u1605 \u1581 \u1605 \u1608 \u1604  \u1575 \u1604 \u1584 \u1610  \u1610 \u1604 \u1581 \u1602  \u1575 \u1604 \u1570 \u1582 \u1585 \u1548  \u1608 \u1575 \u1582 \u1584 \u1606 \u1575  (\u1633 \u1633 ) \u1584 \u1604 \u1603 \
\
\uc0\u1605 \u1579 \u1609  \u1604 \u1605  \u1578 \u1606 \u1593 \u1605 \u1617 \u1585  \u1576 \u1593 \u1590 \u1607 \u1575  \u1605 \u1606  \u1576 \u1593 \u1590  \u1601 \u1610  \u1575 \u1604 \u1606 \u1601 \u1587  \u1578 \u1576 \u1610 \u1610 \u1585 \u1575 \u1611  \u1606 \u1575 \u1602 \u1605 \u1575 \u1611  \u1581 \u1578 \u1609  \u1610 \u1582 \u1604 \u1589  \u1603 \u1604 \u1617  \u1608 \u1575 \u1581 \u1583  \u1605 \u1606 \u1607 \u1575  \u1601 \u1610  \u1575 \u1604 \u1584 \u1607 \u1606  \u1576 \u1591 \u1576 \u1610 \u1593 \u1578 \u1607  \u1575 \u1604 \u1578 \u1610  \u1578 \u1582 \u1589 \u1617 \u1607  \u1605 \u1580 \u1585 \u1617 \u1583 \u1577 \u1548  \u1604 \u1605  \u1610 \u1582 \u1604 \u1589  \u1575 \u1604 \u1605 \u1608 \u1590 \u1608 \u1593  \u1601 \u1610 \u1607 \u1575  \u1605 \u1608 \u1590 \u1608 \u1593 \u1575 \u1611  \u1604 \u1604 \u1605 \u1581 \u1605 \u1608 \u1604  \u1601 \u1610 \u1607 \u1575  (\u1633 \u1636 ) \u1603 \u1604 \u1617 \u1605 \u1575  \u1593 \u1604 \u1609  \u1575 \u1604 \u1606 \u1593 \u1605 \u1575  \u1576 \u1604  \u1610 \u1576 \u1602 \u1609  \u1601 \u1610 \u1607  \u1605 \u1608 \u1590 \u1593  \u1588 \u1585 \u1591 \u1610 \u1577  \u1605 \u1575  \u1571 \u1608  \u1588 \u1585 \u1575 \u1574 \u1591 \u1607  \u1608 \u1610 \u1615 \u1587 \u1578 \u1593 \u1605 \u1604  \u1601 \u1610  \u1571 \u1608 \u1604  \u1575 \u1604 \u1571 \u1605 \u1585  \u1593 \u1604 \u1609  \u1571 \u1603 \u1579 \u1585  \u1605 \u1575  \u1610 \u1605 \u1603 \u1606  \u1575 \u1604 \u1573 \u1606 \u1587 \u1575 \u1606  \u1605 \u1606  \u1575 \u1604 \u1578 \u1582 \u1604 \u1617 \u1589  \u1573 \u1604 \u1609  \u1571 \u1606  \u1606 \u1585 \u1583  \u1576 \u1593 \u1583  \u1584 \u1604 \u1603  (\u1633 ) \u1575 \u1604 \u1605 \u1593 \u1575 \u1606 \u1583 \u1575 \u1578  [\u1581 \u1614 \u1605  \u1641 \u1632  \u1591 ] \u1601 \u1578 \u1582 \u1604 \u1617 \u1589 \u1607 .\
