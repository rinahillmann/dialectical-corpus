\uc0\u1605 \u1582 \u1604 \u1589 \u1577  \u1601 \u1610 \u1592 \u1606  \u1576 \u1607 \u1584 \u1575  \u1575 \u1604 \u1589 \u1606 \u1601  \u1605 \u1606  \u1575 \u1604 \u1575 \u1587 \u1578 \u1602 \u1585 \u1575 \u1569  \u1571 \u1606 \u1607  \u1589 \u1606 \u1601  \u1570 \u1582 \u1585  \u1605 \u1606  \u1575 \u1604 \u1575 \u1587 \u1578 \u1602 \u1585 \u1575 \u1569  [\u1576  \u1634 \u1636 \u1634 \u1607 ]. \u1594 \u1610 \u1585  \u1575 \u1604 \u1571 \u1608 \u1604 \u1548  \u1608 \u1604 \u1610 \u1587  \u1575 \u1604 \u1571 \u1605 \u1585  \u1593 \u1604 \u1609  \u1605 \u1575  \u1592 \u1606 \u1608 \u1607 . \u1608 \u1584 \u1604 \u1603  \u1571 \u1606  \u1607 \u1584 \u1575  \u1575 \u1604 \u1575 \u1587 \u1578 \u1602 \u1585 \u1575 \u1569  \u1604 \u1605  \u1610 \u1602 \u1589 \u1583  \u1576 \u1607  \u1578 \u1589 \u1581 \u1610 \u1581  \u1575 \u1604 \u1581 \u1603 \u1605  \u1575 \u1604 \u1605 \u1608 \u1580 \u1608 \u1583  \u1604 \u1604 \u1571 \u1588 \u1610 \u1575 \u1569  \u1575 \u1604 \u1578 \u1610  \u1575 \u1587 \u1578 \u1602 \u1585 \u1578  \u1601 \u1610  \u1575 \u1604 \u1576 \u1575 \u1602 \u1610 \u1577  \u1575 \u1604 \u1578 \u1610  \u1604 \u1605  \u1578 \u1587 \u1578 \u1602 \u1585 \u1548  \u1608 \u1604 \u1603 \u1606  \u1602 \u1589 \u1583  \u1571 \u1606  \u1610 \u1589 \u1581 \u1617 \u1581  \u1575 \u1604 \u1581 \u1603 \u1605  \u1575 \u1604 \u1605 \u1608 \u1580 \u1608 \u1583  (\u1633 \u1632 ). \u1604 \u1607 \u1575  (\u1633 \u1633 ) \u1601 \u1610  \u1603 \u1604 \u1617 \u1610  \u1610 \u1593 \u1605 \u1617 \u1607 \u1575  \u1608 \u1607 \u1608  \u1575 \u1604 \u1584 \u1610  \u1576 \u1607  \u1578 \u1588 \u1575 \u1576 \u1607 \u1578 \u1548  \u1601 \u1575 \u1578 \u1601 \u1602  \u1571 \u1606  \u1604 \u1605  \u1610 \u1603 \u1606  \u1604 \u1584 \u1604 \u1603  \u1575 \u1604 \u1603 \u1604 \u1617 \u1610  \u1575 \u1587 \u1605  \u1608 \u1573 \u1578 \u1605 \u1575  \u1601 \u1607 \u1605  \u1576 \u1575 \u1604 \u1590 \u1605 \u1610 \u1585 . \u1601 \u1575 \u1604 \u1581 \u1603 \u1605  \u1573 \u1578 \u1605 \u1575  \u1589 \u