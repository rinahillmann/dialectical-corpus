\uc0\u1605 \u1606  \u1575 \u1604 \u1605 \u1580 \u1610 \u1576  \u1575 \u1604 \u1605 \u1602 \u1583 \u1605 \u1575 \u1578  \u1575 \u1604 \u1578 \u1610  \u1610 \u1585 \u1609  \u1571 \u1606 \u1607 \u1575  \u1606 \u1575 \u1601 \u1593 \u1577  \u1601 \u1610  \u1573 \u1576 \u1591 \u1575 \u1604  \u1584 \u1604 \u1603  \u1575 \u1604 \u1608 \u1590 \u1593  \u1605 \u1602 \u1583 \u1605 \u1577  [\u1581 \u1605 \u1607  \u1571 \u1607 ] \u1605 \u1602 \u1583 \u1605 \u1577 . \u1601 \u1573 \u1584 \u1575  \u1581 \u1589 \u1604  \u1593 \u1606 \u1583 \u1607  \u1605 \u1606  \u1575 \u1604 \u1605 \u1602 \u1583 \u1605 \u1575 \u1578  \u1575 \u1604 \u1578 \u1610  \u1587 \u1604 \u1605 \u1607 \u1575  \u1575 \u1604 \u1605 \u1580 \u1610 \u1576  \u1605 \u1602 \u1583 \u1605 \u1575 \u1578  \u1573 \u1584 \u1575  \u1571 \u1604 \u1601 \u1607 \u1575  \u1604 \u1586 \u1605  \u1605 \u1606 \u1607 \u1575  \u1606 \u1602 \u1610 \u1590  \u1575 \u1604 \u1608 \u1590 \u1593 \u1548  \u1580 \u1605 \u1593 \u1607 \u1575  (1) \u1608 \u1571 \u1606 \u1578 \u1580  (2) \u1605 \u1606 \u1607 \u1575  (3) \u1575 \u1604 \u1606 \u1602 \u1610 \u1590 \u1548  \u1605 \u1582 \u1575 \u1591 \u1576 \u1607 \u1575  \u1576 \u1607 \u1575  \u1604 \u1604 \u1605 \u1580 \u1610 \u1576  \u1593 \u1604 \u1609  \u1591 \u1585 \u1610 \u1602  \u1575 \u1604 \u1573 \u1582 \u1576 \u1575 \u1585  (4) \u1604 \u1575  \u1593 \u1604 \u1609  \u1591 \u1585 \u1610 \u1602  \u1575 \u1604 \u1587 \u1572 \u1575 \u1604  (5). \u1601 \u1573 \u1584 \u1575  \u1581 \u1615 \u1605  \u1584 \u1604 \u1603  \u1593 \u1604 \u1609  \u1575 \u1604 \u1605 \u1580 \u1610 \u1576  (6) \u1601 \u1602 \u1583  \u1581 \u1589 \u1604  \u1593 \u1604 \u1610 \u1607  \u1578 \u1576 \u1610 \u1603 \u1610 \u1578 . \u1601 \u1575 \u1604 \u1578 \u1576 \u1603 \u1610 \u1578  (7) \u1607 \u1608  \u1575 \u1604 \u1602 \u1610 \u1575 \u1587  \u1575 \u1604 \u1584 \u1610  \u1610 \u1606 \u1578 \u1580  \u1605 \u1606 \u1607  \u1575 \u1604 \u1587 \u1575 \u1574 \u1604  \u1605 \u1606 \u1575 \u1602 \u1590  (8) \u1605 \u1575  \u1578 \u1590 \u1605 \u1606 \u1607  \u1575 \u1604 \u1605 \u1580 \u1610 \u1576  \u1581 \u1601 \u1592 \u1607  \u1605 \u1606  \u1585 \u1571 \u1610  \u1571 \u1608  \u1608 \u1590 \u1593 . \u1608 \u1604 \u1610 \u1587  \u1604 \u1604 \u1587 \u1575 \u1574 \u1604  \u1571 \u1606  \u1610 \u1593 \u1605 \u1604  \u1578 \u1576 \u1610 \u1603 \u1610 \u1578 \u1575 \u1611  \u1593 \u1604 \u1609  \u1605 \u1580 \u1610 \u1576  \u1580 \u1583 \u1604 \u1610  \u1605 \u1606  \u1605 \u1602 \u1583 \u1605 \u1575 \u1578  \u1604 \u1575  \u1610 \u1587 \u1604 \u1605 \u1607 \u1575  \u1575 \u1604 \u1605 \u1580 \u1610 \u1576 . \u1608 \u1575 \u1604 \u1605 \u1580 \u1610 \u1576  \u1573 \u1584 \u1575  \u1601 \u1585 \u1590  \u1575 \u1604 \u1608 \u1590 \u1593  \u1575 \u1604 \u1584 \u1610  \u1610 \u1582 \u1578 \u1575 \u1585 \u1607  \u1604 \u1606 \u1601 \u1587 \u1607  (9) \u1601 \u1587 \u1610 \u1576 \u1604 \u1594  \u1576 \u1593 \u1583  \u1584 \u1604 \u1603  \u1571 \u1606  \u1610 \u1578 \u1581 \u1602 \u1602  \u1605 \u1606  \u1571 \u1606  \u1610 \u1587 \u1604 \u1605  \u1604 \u1604 \u1587 \u1575 \u1574 \u1604  \u1575 \u1604 \u1605 \u1602 \u1583 \u1605 \u1575 \u1578  \u1575 \u1604 \u1578 \u1610  \u1610 \u1606 \u1578 \u1601 \u1593  \u1576 \u1607 \u1575  \u1575 \u1604 \u1587 \u1575 \u1574 \u1604  \u1601 \u1610  \u1573 \u1576 \u1591 \u1575 \u1604  \u1575 \u1604 \u1608 \u1590 \u1593 . \u1576 \u1604  \u1573 \u1606 \u1605 \u1575  \u1610 \u1606 \u1576 \u1594 \u1610  \u1593 \u1606 \u1583  \u1603 \u1604  \u1587 \u1572 \u1575 \u1604  \u1571 \u1606  \u1610 \u1606 \u1581 \u1585 \u1610 \u1548  \u1601 \u1610  \u1603 \u1604  \u1605 \u1575  \u1610 \u1587 \u1604 \u1605 \u1607  (10) \u1605 \u1606  \u1580 \u1586 \u1574 \u1610  \u1575 \u1604 \u1606 \u1602 \u1610 \u1590 \u1548  \u1575 \u1604 \u1580 \u1586 \u1569  (11) \u1575 \u1604 \u1584 \u1610  \u1604 \u1575  \u1610 \u1606 \u1578 \u1601 \u1593  \u1576 \u1607  \u1575 \u1604 \u1587 \u1575 \u1574 \u1604  \u1601 \u1610  \u1605 \u1606 \u1575 \u1602 \u1590 \u1577  \u1575 \u1604 \u1605 \u1580 \u161