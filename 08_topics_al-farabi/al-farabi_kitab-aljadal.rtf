(\uc0\u1634 \u1634 ) \u1608 \u1571 \u1610 \u1590 \u1575 \u1611  \u1601 \u1573 \u1606  \u1575 \u1604 \u1571 \u1605 \u1585 \u1548  \u1605 \u1579 \u1609  \u1575 \u1601 \u1578 \u1585 \u1606 \u1578  \u1573 \u1604 \u1610 \u1607  \u1605 \u1575 \u1574 \u1577  \u1571 \u1608  \u1605 \u1585 \u1590  \u1605 \u1606  \u1575 \u1604 \u1571 \u1605 \u1585 \u1575 \u1590  \u1608 \u1605 \u1587 \u1585 \u1617  \u1606 \u1589 \u1617 \u1608 \u1585 \u1607  (\u1633 ) - \u1571 \u1608  \u1604 \u1605  \u1610 \u1603 \u1606  - \u1583 \u1608 \u1606  \u1575 \u1604 \u1605 \u1575 \u1574 \u1577  \u1608 \u1583 \u1608 \u1606  \u1578 \u1604 \u1603  (\u1634 ) \u1575 \u1604 \u1571 \u1605 \u1585 \u1575 \u1590 \u1548  \u1571 \u1605 \u1603 \u1606  \u1571 \u1606  \u1610 \u1603 \u1608 \u1606  \u1575 \u1604 \u1605 \u1581 \u1605 \u1608 \u1604  \u1593 \u1604 \u1609  \u1584 \u1604 \u1603  \u1575 \u1604 \u1588 \u1610 \u1569 \u1548  \u1605 \u1606  \u1581 \u1610 \u1579  \u1607 \u1608  \u1605 \u1608 \u1589 \u1608 \u1601  \u1576 \u1578 \u1604 \u1603  \u1575 \u1604 \u1605 \u1575 \u1574 \u1577 \u1548  \u1603 \u1575 \u1606  \u1605 \u1581 \u1605 \u1608 \u1604 \u1575 \u1611  \u1589 \u1583 \u1617  \u1605 \u1581 \u1605 \u1608 \u1604 \u1575 \u1611 \u1548  \u1601 \u1573 \u1584 \u1575  \u1604 \u1605  \u1610 \u1606 \u1593 \u1610 \u1617 \u1585  \u1604 \u1606 \u1575  \u1584 \u1604 \u1603  (\u1636 ) \u1575 \u1604 \u1588 \u1610 \u1569 \u1548  \u1605 \u1606  \u1581 \u1610 \u1579  \u1607 \u1608  \u1605 \u1601 \u1585 \u1583  \u1605 \u1606  \u1606 \u1601 \u1587 \u1607  \u1608 \u1605 \u1606  (\u1637 ) \u1581 \u1610 \u1579  \u1607 \u1608  \u1605 \u1602 \u1578 \u1585 \u1606  \u1605 \u1575 \u1574 \u1577  \u1608 \u1571 \u1582 \u1584 \u1606 \u1575 \u1607  \u1576 \u1581 \u1575 \u1604  \u1608 \u1575 \u1581 \u1583 \u1577 \u1548  \u1604 \u1581 \u1602  \u1584 \u1604 \u1603  \u1575 \u1604 \u1588 \u1610 \u1569  \u1575 \u1604 \u1608 \u1575 \u1581 \u1583  \u1605 \u1581 \u1605 \u1608 \u1604 \u1575 \u1611  \u1605 \u1578 \u1589 \u1575 \u1583 \u1617 \u1575 \u1