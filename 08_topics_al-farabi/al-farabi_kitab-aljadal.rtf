\
(\uc0\u1634 \u1639 ) \u1608 \u1571 \u1610 \u1590 \u1575 \u1611  \u1601 \u1573 \u1606  \u1603 \u1579 \u1610 \u1585 \u1575 \u1611  \u1605 \u1606  \u1575 \u1604 \u1571 \u1588 \u1610 \u1575 \u1569  \u1573 \u1606 \u1605 \u1575  \u1610 \u1615 \u1576 \u1578 \u1583 \u1571  \u1601 \u1610  \u1605 \u1593 \u1585 \u1601 \u1578 \u1607 \u1575  \u1605 \u1606  \u1575 \u1604 \u1605 \u1593 \u1585 \u1601 \u1577 \
\uc0\u1575 \u1604 \u1571 \u1608 \u1604 \u1609  \u1575 \u1604 \u1578 \u1610  \u1578 \u1587 \u1578 \u1606 \u1578 \u1580  (\u1633 ) \u1604 \u1604 \u1573 \u1606 \u1587 \u1575 \u1606  \u1601 \u1610  \u1576 \u1575 \u1583 \u1574  \u1575 \u1604 \u1585 \u1571 \u1610 . \u1593 \u1606 \u1583  \u1575 \u1604 \u1580 \u1605 \u1610 \u1593 . \u1601 \u1573 \u1584 \u1575  \u1578 \u1571 \u1605 \u1604 \u1607 \u1575  \u1608 \u1580 \u1583  \u1605 \u1575 \
\uc0\u1610 \u1593 \u1575 \u1606 \u1583  \u1578 \u1604 \u1603  \u1575 \u1604 \u1605 \u1593 \u1585 \u1601 \u1577  \u1601 \u1610 \u1603 \u1608 \u1606  [\u1576  \u1634 \u1632 \u1634  \u1607 \u1600 ] \u1575 \u1604 \u1605 \u1593 \u1575 \u1606 \u1583  \u1575 \u1604 \u1584 \u1610  \u1608 \u1580 \u1583 \u1578 \u1607  (\u1634 ) \u1607 \u1608  \u1575 \u1604 \u1584 \u1610  \u1610 \u1606 \u1578 \u1576 \u1607 \
\uc0\u1593 \u1604 \u1609  \u1605 \u1593 \u1585 \u1601 \u1577  \u1588 \u1610 \u1569 \u1548  \u1603 \u1575 \u1606  \u1601 \u1606 \u1583 \u1575 \u1611  (\u1635 ) \u1571 \u1601 \u1593 \u1604 \u1607  (\u1636 ) \u1601 \u1610  \u1584 \u1604 \u1603  \u1575 \u1604 \u1571 \u1605 \u1585 . \u1579 \u1605  \u1610 \u1578 \u1571 \u1605 \u1604  \u1584 \u1604 \u1603  \u1601 \u1610 \u1580 \u1583 \u1583  \u1571 \u1610 \u1590 \u1575 \u1611 \
\uc0\u1605 \u1593 \u1575 \u1606 \u1583 \u1575 \u1611  \u1570 \u1582 \u1585  \u1604 \u1604 \u1605 \u1593 \u1585 \u1601 \u1577  \u1575 \u1604 \u1586 \u1575 \u1574 \u1583 \u1577  \u1575 \u1604 \u1578 \u1610  \u1571 \u1601 \u1575 \u1583 \u1607 \u1575  \u1573 \u1610 \u1575 \u1607  \u1575 \u1604 \u1605 \u1593 \u1575 \u1606 \u1583  \u1575 \u1604 \u1571 \u1608 \u1604 \u1548  \u1601 \u1610 \u1606 \u1578 \u1576 \u1607  \u1575 \u1604 \u1605 \u1593 \u1575 \u1606 \u1583 \
\uc0\u1575 \u1604 \u1579 \u1575 \u1606 \u1610  \u1593 \u1604 \u1609  \u1605 \u1593 \u1585 \u1601 \u1577  \u1588 \u1610 \u1569 \u1548  \u1603 \u1575 \u1606  \u1602 \u1583  \u1571 \u1601 \u1593 \u1604 \u1607  (\u1637 ). \u1601 \u1604 \u1575  \u1610 \u1586 \u1575 \u1604  \u1603 \u1584 \u1604 \u1603  \u1573 \u1604 \u1609  \u1571 \u1606  \u1610 \u1571 \u1578 \u1610  \u1576 \u1607 \u1584 \u1575 \
\uc0\u1575 \u1604 \u1578 \u1585 \u1578 \u1610 \u1576  \u1593 \u1604 \u1609  \u1580 \u1605 \u1610 \u1593  \u1605 \u1575  \u1610 \u1606 \u1576 \u1594 \u1610  \u1571 \u1606  \u1610 \u1593 \u1604 \u1605  \u1605 \u1606  \u1571 \u1605 \u1585  \u1584 \u1604 \u1603  \u1575 \u1604 \u1588 \u1610 \u1569 . \u1608 \u1607 \u1584 \u1607  \u1604 \u1610 \u1587  \u1610 \u1605 \u1603 \u1606 \
\uc0\u1571 \u1606  \u1610 \u1580 \u1585 \u1610  \u1601 \u1610 \u1607 \u1575  (\u1638 ) \u1593 \u1604 \u1609  \u1607 \u1584 \u1575  \u1575 \u1604 \u1578 \u1585 \u1578 \u1610 \u1576  \u1576 \u1589 \u1606 \u1575 \u1593 \u1577  \u1573 \u1604 \u1575  (\u1639 ) \u1576 \u1589 \u1606 \u1575 \u1593 \u1577  \u1575 \u1604 \u1580 \u1583 \u1604  (\u1640 ). \u1601 \u1589 \u1606 \u1575 \u1593 \u1577 \
\uc0\u1575 \u1604 \u1580 \u1583 \u1604  \u1573 \u1584 \u1606  \u1601 \u1610  \u1603 \u1579 \u1610 \u1585  \u1605 \u1606  \u1575 \u1604 \u1571 \u1588 \u1610 \u1575 \u1569  \u1578 \u1593 \u1591 \u1609  \u1605 \u1576 \u1575 \u1583 \u1574  \u1575 \u1604 \u1606 \u1592 \u1585  \u1593 \u1604 \u1609  \u1607 \u1584 \u1607  \u1575 \u1604 \u1580 \u1607 \u1577 .\
\
(\uc0\u1634 \u1640 ) \u1608 \u1571 \u1610 \u1590 \u1575 \u1611  \u1601 \u1573 \u1606  \u1575 \u1604 \u1576 \u1585 \u1575 \u1607 \u1610 \u1606  \u1593 \u1604 \u1609  \u1590 \u1585 \u1593 \u1610 \u1606 : \u1571 \u1581 \u1583 \u1607 \u1605 \u1575  \u1593 \u1604 \u1609  \u1575 \u1604 \u1573 \u1591 \u1604 \u1575 \u1602  \u1608 \u1575 \u1604 \u1570 \u1582 \u1585 \u1576 \u1575 \u1604 \u1573 \u1590 \u1575 \u1601 \u1577 \u1548  \u1601 \u1575 \u1604 \u1584 \u1610  \u1593 \u1604 \u1609  \u1575 \u1604 \u1573 \u1591 \u1604 \u1575 \u1602  \u1607 \u1608  \u1575 \u1604 \u1584 \u1610  \u1610 \u1593 \u1591 \u1610  \u1576 \u1584 \u1575 \u1578 \u1607  \u1575 \u1604 \u1610 \u1602 \u1610 \u1606  \u1593 \u1604 \u1609  \u1575 \u1604 \u1573 \u1591 \u1604 \u1575 \u1602 . \u1608 \u1575 \u1604 \u1584 \u1610  (\u1633 ) \u1576 \u1575 \u1604 \u1573 \u1590 \u1575 \u1601 \u1577  \u1607 \u1608  \u1575 \u1604 \u1584 \u1610  \u1610 \u1603 \u1608 \u1606  \u1576 \u1585 \u1607 \u1575 \u1606 \u1606 \u1575  \u1576 \u1581 \u1587 \u1576  \u1573 \u1606 \u1587 \u1575 \u1606  \u1605 \u1575  \u1571 \u1608  \u1591 \u1575 \u1574 \u1601 \u1577  (\u1634 ) \u1605 \u1575 . \u1601 \u1605 \u1576 \u1575 \u1583 \u1574  \u1575 \u1604 \u1593 \u1604 \u1608 \u1605  \u1575 \u1604 \u1610 \u1601 \u1610 \u1606 \u1610 \u1577  (\u1635 ) \u1604 \u1610 \u1587  \u1605 \u1605 \u1603 \u1606  \u1571 \u1606  \u1610 \u1603 \u1608 \u1606  \u1605 \u1606 \u1607 \u1575  \u1576 \u1585 \u1575 \u1607 \u1606  \u1576 \u1575 \u1604 \u1573 \u1590 \u1575 \u1601 \u1577  \u1576 \u1581 \u1587 \u1576  \u1591 \u1575 \u1574 \u1601 \u1577  \u1605 \u1575  \u1571 \u1608  \u1576 \u1581 \u1587 \u1576  \u1573 \u1606 \u1587 \u1575 \u1606  \u1576 \u1593 \u1610 \u1606 \u1607  (\u1636 ) (\u1573 \u1584 \u1575 \u1607 ) \u1603 \u1575 \u1606  \u1584 \u1604 \u1603  \u1575 \u1604 \u1573 \u1606 \u1587 \u1575 \u1606  \u1608 \u1581 \u1583 \u1607  \u1571 \u1608  \u1575 \u1604 \u1591 \u1575 \u1574 \u1601 \u1577  \u1608 \u1581 \u1583 \u1607 \u1575  \u1604 \u1575  \u1578 \u1593 \u1578 \u1585 \u1601  \u1576 \u1606 \u1578 \u1604 \u1603  \u1575 \u1604 \u1605 \u1576 \u1575 \u1583 \u1574  - (\u1637 ) \u1603 \u1575 \u1606 \u1578  \u1607 \u1606 \u1575 \u1603  \u1571 \u1588 \u1610 \u1575 \u1569  \u1578 \u1602 \u1604 \u1591 \u1607  \u1608 \u1581 \u1583 \u1607  \u1608 \u1575 \u1604 \u1576 \u1585 \u1575 \u1607 \u1610 \u1606  \u1575 \u1604 \u1578 \u1610  \u1576 \u1581 \u1587 \u1576  \u1573 \u1606 \u1587 \u1575 \u1606  \u1605 \u1575  \u1573 \u1578 \u1605 \u1575  \u1578 \u1572 \u1604 \u1601  \u1605 \u1606  \u1575 \u1604 \u1571 \u1588 \u1610 \u1575 \u1569  \u1575 \u1604 \u1605 \u1588 \u1607 \u1608 \u1585 \u1577  \u1575 \u1604 \u1578 \u1610  \u1604 \u1575  \u1610 \u1593 \u1585 \u1610  \u1571 \u1581 \u1583  \u1605 \u1606  \u1571 \u1606  \u1610 \u1603 \u1608 \u1606  \u1584 \u1604 \u1603  \u1585 \u1571 \u1610 \u1575 \u1611  \u1604 \u1607 . \u1608 \u1607 \u1584 \u1607  \u1575 \u1604 \u1576 \u1585 \u1575 \u1607 \u1610 \u1606  [\u1581 \u1614 \u1605  \u1641 \u1633 ] \u1607 \u1610  \u1602 \u1610 \u1575 \u1587 \u1575 \u1578  \u1578 \u1572 \u1582 \u1584  (\u1639 ) \u1605 \u1606  \u1589 \u1606 \u1575 \u1593 \u1577  \u1575 \u1604 \u1605 \u1580 \u1604 \u1583 . \u1601 \u1605 \u1606  \u1607 \u1584 \u1607  \u1575 \u1604 \u1580 \u1607 \u1577  \u1602 \u1583  \u1610 \u1578 \u1601 \u1602  \u1571 \u1610 \u1590 \u1575 \u1611  \u1575 \u1604 \u1605 \u1580 \u1604 \u1583  \u1601 \u1610  \u1605 \u1576 \u1575 \u1583 \u1574  \u1575 \u1604 \u1593 \u1604 \u1608 \u1605  \u1575 \u1604 \u1610 \u1601 \u1610 \u1606 \u1610 \u1577 . \u1601 \u1573 \u1606 \u1607  \u1604 \u1575  \u1610 \u1605 \u1606 \u1593  (\u1640 ) \u1571 \u1606  \u1610 \u1603 \u1608 \u1606  \u1601 \u1610  \u1575 \u1604 \u1606 \u1575 \u1587  \u1605 \u1606  \u1610 \u1578 \u1588 \u1603 \u1603  (\u1641 ) \u1601 \u1610  \u1575 \u1604 \u1571 \u1588 \u1610 \u1575 \u1569  \u1575 \u1604 \u1592 \u1575 \u1607 \u1585 \u1577  \u1575 \u1604 \u1576 \u1610 \u1574 \u1610 \u1577  \u1576 \u1571 \u1606 \u1601 \u1587 \u1607 \u1575  - \u1593 \u1604 \u1609  \u1605 \u1579 \u1575 \u1604  \u1605 \u1575  \u1606 \u1580 \u1583  \u1602 \u1608 \u1605 \u1575 \u1611  \u1604 \u1575  \u1610 \u1593 \u1578 \u1585 \u1601 \u1608 \u1606  (\u1633 \u1632 ) \u1571 \u1606  \u1575 \u1604 \u1605 \u1578 \u1606 \u1575 \u1602 \u1590 \u1575 \u1578  \u1604 \u1575  \u1578 \u1589 \u1583 \u1602  \u1605 \u1593 \u1575 \u1611  \u1608 \u1603 \u1605 \u1575  \u1571 \u1606  \u1602 \u1608 \u1605 \u1575 \u1611  \u1610 \u1606 \u1603 \u1585 \u1608 \u1606  \u1571 \u1606  \u1610 \u1608 \u1580 \u1583  \u1588 \u1610 \u1569  \u1610 \u1578 \u1581 \u1585 \u1603  [\u1576 .\u1634 \u1632 .\u1635 ] \u1608 \u1571 \u1607 \u1585 \u1608 \u1606  \u1610 \u1593 \u1578 \u1585 \u1601 \u1608 \u1606  \u1576 \u1575 \u1604 \u1605 \u1606 \u1581 \u1585 \u1603  \u1608 \u1610 \u1576 \u1591 \u1604 \u1608 \u1606  \u1575 \u1604 \u1581 \u1585 \u1603 \u1577 . \u1601 \u1575 \u1604 \u1576 \u1585 \u1575 \u1607 \u1610 \u1606  (\u1633 \u1633 ) \u1575 \u1604 \u1578 \u1610  \u1576 \u1607 \u1575  \u1578 \u1579 \u1576 \u1578  \u1605 \u1606 \u1583 \u1607 \u1605  \u1575 \u1604 \u1581 \u1585 \u1603 \u1577  \u1608 \u1575 \u1604 \u1605 \u1606 \u1581 \u1585 \u1603  \u1608 \u1571 \u1606  (\u1633 \u1634 ) \u1575 \u1604 \u1605 \u1578 \u1606 \u1575 \u1602 \u1590 \u1610 \u1606  \u1604 \u1575  \u1610 \u1589 \u1583 \u1602 \u1575 \u1606  \u1605 \u1593 \u1575 \u1611  \u1607 \u1610  \u1575 \u1604 \u1576 \u1585 \u1575 \u1607 \u1610 \u1606  (\u1633 \u1635 ) \u1576 \u1575 \u1604 \u1573 \u1590 \u1575 \u1601 \u1577  \u1573 \u1604 \u1609  \u1571 \u1608 \u1604 \u1574 \u1603  \u1608 \u1573 \u1578 \u1605 \u1575  \u1610 \u1603 \u1608 \u1606  \u1593 \u1606  \u1575 \u1604 \u1605 \u1602 \u1583 \u1605 \u1575 \u1578  \u1575 \u1604 \u1605 \u1588 \u1607 \u1608 \u1585 \u1577  \u1608 \u1603 \u1584 \u1604 \u1603  \u1605 \u1582 \u1575 \u1591 \u1576 \u1577  \u1605 \u1606  \u1610 \u1606 \u1603 \u1585  \u1608 \u1580 \u1608 \u1583  \u1575 \u1604 \u1603 \u1579 \u1585 \u1577  \u1608 \u1610 \u1604 \u1578 \u1586 \u1605  \u1571 \u1606  \u1610 \u1576 \u1610 \u1606  \u1571 \u1606  (\u1633 \u1636 ) \u1575 \u1604 \u1605 \u1608 \u1580 \u1608 \u1583  \u1608 \u1575 \u1581 \u1583 \
\
\uc0\u1573 \u1578 \u1605 \u1575  \u1610 \u1606 \u1576 \u1594 \u1610  \u1571 \u1606  \u1578 \u1603 \u1608 \u1606  \u1576 \u1575 \u1604 \u1602 \u1610 \u1575 \u1587 \u1575 \u1578  \u1575 \u1604 \u1605 \u1572 \u1604 \u1601 \u1577  \u1593 \u1606  (\u1633 \u1637 ) \u1575 \u1604 \u1605 \u1602 \u1583 \u1605 \u1575 \u1578  \u1575 \u1604 \u1605 \u1588 \u1607 \u1608 \u1585 \u1577  \u1601 \u1604 \u1584 \u1604 \u1603  \u1602 \u1575 \u1604 \
\uc0\u1571 \u1585 \u1587 \u1591 \u1608  \u1591 \u1575 \u1604 \u1610 \u1587  \u1601 \u1610  \u1571 \u1608 \u1604  \u1575 \u1604 \u1587 \u1605 \u1575 \u1593  \u1575 \u1604 \u1591 \u1576 \u1610 \u1593 \u1610  \u1593 \u1606 \u1583 \u1605 \u1575  \u1571 \u1585 \u1575 \u1583  \u1571 \u1606  \u1610 \u1588 \u1585 \u1593  \u1601 \u1610  \u1605 \u1582 \u1575 \u1591 \u1576 \u1577 \
\uc0\u1576 \u1585 \u1605 \u1606 \u1610 \u1583 \u1587  \'ab\u1606 \u1581 \u1606  \u1606 \u1582 \u1575 \u1591 \u1576 \u1603 \u1605  (\u1633 \u1638 ) \u1580 \u1583 \u1604 \u1610 \u1606  \u1608 \u1573 \u1606  \u1601 \u1610  \u1605 \u1582 \u1575 \u1591 \u1576 \u1578 \u1607 \u1605  \u1601 \u1604 \u1587 \u1601 \u1577  \u1605 \u1575 \'bb.\
\
\'ab \uc0\u1607 \u1606 \u1575 \u1601 \u1593  \u1589 \u1606 \u1575 \u1593 \u1577  \u1575 \u1604 \u1581 \u1583 \u1604  \'bb\
