\uc0\u1608 \u1593 \u1604 \u1609  \u1603 \u1605 \u1617 \u1610 \u1577  \u1605 \u1575  \u1571 \u1578 \u1575 \u1607  \u1571 \u1610 \u1590 \u1575 \u1611  \u1587 \u1575 \u1604 \u1576  \u1582 \u1575 \u1585 \u1580  \u1575 \u1604 \u1606 \u1601 \u1587  \u1608 \u1593 \u1604 \u1609  \u1578 \u1604 \u1603  \u1575 \u1604 \u1603 \u1605 \u1617 \u1610 \u1577  \u1576 \u1593 \u1610 \u1606 \u1607 \u1575  (\u1633 \u1633 ). \u1601 \u1573 \u1606  \u1603 \u1575 \u1606  \u1605 \u1575  \u1601 \u1610  \u1575 \u1604 \u1606 \u1601 \u1587  \u1605 \u1606  \u1607 \u1584 \u1607  \u1570 \u1585 \u1575 \u1569  (\u1633 \u1634 ) \u1603 \u1604 \u1610 \u1617 \u1577 \u1548  \u1581 \u1603 \u1605 \u1578  \u1593 \u1604 \u1610 \u1607 \u1575  \u1571 \u1610 \u1590 \u1575 \u1611  \u1571 \u1606 \u1607 \u1575  \u1582 \u1575 \u1585 \u1580  \u1575 \u1604 \u1606 \u1601 \u1587  \u1603 \u1604 \u1610 \u1617 \u1577 . \u1601 \u1610 \u1603 \u1608 \u1606  \u1575 \u1604 \u1573 \u1606 \u1587 \u1575 \u1606  \u1602 \u1583  \u1575 \u1587 \u1578 \u1593 \u1605 \u1604 \u1607 \u1575  \u1608 \u1603 \u1579 \u1610 \u1585  \u1605 \u1606 \u1607 \u1575  \u1603 \u1575 \u1584 \u1576 \u1577  \u1576 \u1575 \u1604 \u1580 \u1586 \u1569 \u1548  \u1608 \u1604 \u1575  (\u1633 \u1635 ) \u1610 \u1588 \u1593 \u1585  \u1576 \u1603 \u1578 \u1576 \u1607 \u1575  \u1608 \u1603 \u1579 \u1610 \u1585  \u1605 \u1606 \u1607 \u1575  \u1578 \u1603 \u1608 \u1606  \u1605 \u1602 \u1575 \u1576 \u1604 \u1575 \u1578 \u1607 \u1575  (\u1633 \u1636 ) \u1605 \u1588 \u1607 \u1608 \u1585 \u1577  \u1571 \u1610 \u1590 \u1575 \u1611  \u1605 \u1606  \u1581 \u1610 \u1579  \u1607 \u1610  \u1603 \u1604 \u1610 \u1617 \u1577 . \u1601 \u1610 \u1603 \u1608 \u1606  \u1604 \u1584 \u1604 \u1603  \u1610 \u1571 \u1582 \u1584 \u1607 \u1575  (\u1633 ) [\u1576 \u1580  \u1633 \u1641 \u1636 \u1592 ] \u1576 \u1593 \u1610 \u1606 \u1610 \u1577  (\u1633 \u1638 ) \u1608 \u1607 \u1610  \u1592 \u1606 \u1608 \u1606 \u1548  \u1608 \u1589 \u1575 \u1583 \u1602 \u1577  \u1576 \u1575 \u1604 \u1603 \u1604 \u1617  \u1608 \u1573 \u1606 \u1605 \u1575  \u1607 \u1610  \u1589 \u1575 \u1583 \u1602 \u1577  \u1576 \u1575 \u1604 \u1580 \u1586 \u1569 .\
\
(\uc0\u1633 \u1636 /\u1635 ) \u1608 \u1604 \u1610 \u1587  \u1601 \u1610  \u1602 \u1608 \u1577  \u1603 \u1604 \u1617  \u1608 \u1575 \u1581 \u1583  (\u1633 ) \u1571 \u1606  \u1610 \u1588 \u1593 \u1585  (\u1634 ) \u1576 \u1575 \u1604 \u1580 \u1586 \u1569  \u1575 \u1604 \u1603 \u1575 \u1584 \u1576  (\u1635 ) \u1601 \u1610  \u1575 \u1604 \u1603 \u1604 \u1610 \u1617 \u1575 \u1578  \u1575 \u1604 \u1578 \u1610  \u1593 \u1606 \u1583 \u1607 \u1548  \u1608 \u1604 \u1575  \u1576 \u1603 \u1604 \u1617  \u1575 \u1604 \u1605 \u1578 \u1602 \u1575 \u1576 \u1604 \u1610 \u1606  \u1605 \u1606  \u1603 \u1604 \u1617  \u1605 \u1588 \u1607 \u1608 \u1585 \u1610 \u1606  \u1605 \u1578 \u1602 \u1575 \u1576 \u1604 \u1610 \u1606 . \u1601 \u1573 \u1606  \u1604 \u1610 \u1587 \u1578  \u1578 \u1601 \u1610  (\u1636 ) \u1602 \u1608 \u1577  \u1603 \u1604 \u1617  (\u1607 ) \u1608 \u1575 \u1581 \u1583  \u1571 \u1606  \u1610 \u1615 \u1593 \u1614 \u1575 \u1606 \u1616 \u1583  \u1575 \u1604 \u1580 \u1615 \u1586 \u1618 \u1569  \u1575 \u1604 \u1603 \u1575 \u1584 \u1576  \u1605 \u1606  \u1603 \u1604 \u1617  \u1603 \u1604 \u1610 \u1617 \u1577  \u1603 \u1575 \u1584 \u1576 \u1577  \u1605 \u1588 \u1607 \u1608 \u1585 \u1577  \u1575 \u1604 \u1603 \u1604 \u1610 \u1617 \u1577 \u1548  \u1608 \u1604 \u1575  \u1571 \u1606  \u1610 \u1615 \u1581 \u1614 \u1604 \u1614 \u1617 \u1589  \u1605 \u1602 \u1583 \u1575 \u1585  \u1605 \u1575  \u1601 \u1610 \u1607 \u1575  \u1605 \u1606  \u1575 \u1604 \u1589 \u1575 \u1583 \u1602 \u1548  \u1601 \u1578 \u1601 \u1585 \u1617 \u1583 \u1607  \u1605 \u1606  \u1575 \u1604 \u1603 \u1575 \u1584 \u1576 . \u1601 \u1573 \u1584 \u1575  \u1604 \u1605  \u1610 \u1605 \u1603 \u1606 \u1607  \u1584 \u1604 \u1603  \u1601 \u1610 \u1607 \u1575 \u1548  \u1604 \u1605  \u1610 \u1605 \u1603 \u1606 \u1607  \u1571 \u1610 \u1590 \u1575 \u1611  \u1571 \u1606  \u1610 \u1615 \u1581 \u1614 \u1604 \u1614 \u1617 \u1589  \u1605 \u1602 \u1583 \u1575 \u1585  (\u1638 ) \u1575 \u1604 \u1589 \u1583 \u1602  \u1601 \u1610  \u1575 \u1604 \u1606 \u1578 \u1575 \u1574 \u1580  \u1575 \u1604 \u1604 \u1575 \u1586 \u1605 \u1577  \u1605 \u1606 \u1607 \u1575 . \u1601 \u1610 \u1576 \u1602 \u1609  \u1603 \u1604 \u1617  \u1585 \u1571 \u1610  \u1605 \u1606  \u1570 \u1585 \u1575 \u1569  \u1575 \u1604 \u1606 \u1575 \u1592 \u1585  - \u1573 \u1605 \u1575  \u1603 \u1604 \u1617 \u1607 \u1575  \u1608 \u1573 \u1605 \u1575  \u1603 \u1579 \u1610 \u1585  \u1605 \u1606 \u1607 \u1575  - \u1589 \u1575 \u1583 \u1602 \u1575 \u1611  \u1605 \u1582 \u1604 \u1608 \u1591 \u1575 \u1611  \u1576 \u1603 \u1578 \u1576  \u1604 \u1605  \u1610 \u1588 \u1593 \u1585  \u1576 \u1607 . \u1608 \u1573 \u1584 \u1575  \u1603 \u1575 \u1606  \u1573 \u1606 \u1605 \u1575  \u1588 \u1593 \u1585  \u1603 \u1604 \u1617  (\u1639 ) \u1608 \u1575 \u1581 \u1583  \u1605 \u1606  \u1575 \u1604 \u1606 \u1575 \u1592 \u1585 \u1610 \u1606  \u1605 \u1606  \u1575 \u1604 \u1605 \u1588 \u1607 \u1608 \u1585 \u1575 \u1578  (\u1640 ) \u1576 \u1605 \u1602 \u1575 \u1576 \u1604  (\u1641 ) \u1605 \u1575  \u1610 \u1588 \u1593 \u1585  \u1576 \u1607  \u1575 \u1604 \u1570 \u1582 \u1585 \u1548  \u1608 \u1575 \u1587 \u1578 \u1593 \u1605 \u1604  (\u1633 \u1632 ) \u1603 \u1604 \u1617  \u1608 \u1575 \u1581 \u1583  \u1601 \u1610  \u1601 \u1581 \u1589 \u1607  \u1608 \u1606 \u1592 \u1585 \u1607  (\u1633 \u1633 ) \u1605 \u1575  \u1610 \u1588 \u1593 \u1585  (\u1633 \u1634 ) \u1576 \u1607  \u1601 \u1602 \u1591  \u1578 \u1590 \u1575 \u1583 \u1617 \u1578  \u1570 \u1585 \u1575 \u1569 \u1607 \u1605  (\u1633 \u1635 ) \u1604 \u1575 \
